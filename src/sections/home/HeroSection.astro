---
import { Image } from "astro:assets";
import heroImg from "../../assets/images/hero.jpg";
import { heroData } from "../../data/hero.js";
---

<section id="inicio" class="hero-wrapper">
  <div class="hero-bg">
    <Image
      src={heroImg}
      width={1920}
      height={1080}
      format="webp"
      quality="80"
      alt="Consultorio clínico profesional"
      class="hero-img-parallax"
      loading="eager"
      fetchpriority="high"
    />

    <div class="hero-overlay"></div>
  </div>

  <div class="container hero-container">
    <div class="row justify-content-start">
      
      <!--columna con alineación real -->
      <div class="col-12 col-lg-7 hero-content animate-fade-in-up">

        <h1 class="hero-title">
          {heroData.title1}
          <span class="text-accent italic animate-pulse-soft">
            {heroData.titleEmphasis}
          </span>
        </h1>

        <p class="hero-description">
          {heroData.description}
        </p>

        <div class="hero-actions">
          <button class="btn-boutique">
            {heroData.ctaPrimary}
          </button>

          <button class="btn-text-link">
            <span class="border-bottom-accent">
              {heroData.ctaSecondary}
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 -960 960 960" fill="currentColor">
              <path d="M647-440H160v-80h487L423-744l57-56 320 320-320 320-57-56 224-224Z"/>
            </svg>
          </button>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .hero-wrapper {
  position: relative;
  min-height: 100dvh;
  display: flex;
  align-items: center;
  overflow: hidden;
  background-color: var(--primary);
}

/* BACKGROUND */
.hero-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.hero-img-parallax {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: brightness(0.75) contrast(1.1);
  transform: scale(1.1);
}

/* OVERLAY UNIFICADO (mejor control) */
.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to right,
    var(--primary) 0%,
    rgba(10, 26, 47, 0.85) 40%,
    rgba(10, 26, 47, 0.2) 100%
  );
}

/* CONTAINER */
.hero-container {
  position: relative;
  z-index: 2;
}

/*evita que Bootstrap centre  raro */
.hero-content {
  text-align: left;
}

/* TITULO */
.hero-title {
  font-family: "Lora", serif;
  font-size: clamp(2.2rem, 5vw, 4rem);
  color: white;
  line-height: 1.15;
  font-weight: 500;
}

/* TEXTO */
.hero-description {
  margin-top: 1.5rem;
  font-size: 1.05rem;
  color: rgba(255, 255, 255, 0.9);
  max-width: 580px;
  line-height: 1.7;
}

/* ACTIONS */
.hero-actions {
  margin-top: 2.5rem;
  display: flex;
  gap: 1.5rem;
  flex-wrap: wrap;
}

/* BOTÓN PRINCIPAL */
.btn-boutique {
  background: var(--accent);
  color: var(--primary);
  padding: 1rem 2rem;
  border: none;
  border-radius: 6px;
  font-weight: 700;
  transition: 0.3s;
}

.btn-boutique:hover {
  transform: translateY(-3px);
  background: white;
}

/* LINK */
.btn-text-link {
  background: transparent;
  border: none;
  color: white;
  display: flex;
  align-items: center;
  gap: 0.6rem;
}

/* MOBILE */
@media (max-width: 768px) {
  .hero-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .hero-title {
    text-align: center;
  }

  .hero-description {
    text-align: center;
    margin-inline: auto;
  }

  .btn-text-link {
    justify-content: center;
  }
}
</style>


<script>
  const setupHero = () => {
    const img = document.querySelector(".hero-img-parallax");

    if (img instanceof HTMLElement) {
      window.addEventListener(
        "scroll",
        () => {
          const scrolled = window.scrollY;
          // Limitar el cálculo para no saturar el procesador
          if (scrolled < window.innerHeight) {
            img.style.transform = `translateY(${scrolled * 0.15}px) scale(1.1)`;
          }
        },
        { passive: true },
      );
    }
  };

  setupHero();
</script>
