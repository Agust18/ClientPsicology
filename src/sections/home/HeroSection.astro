---
import { Image } from 'astro:assets';
import heroImg from '../../assets/images/hero.jpg'; 
import { heroData } from '../../data/site.js';
---

<section id="inicio" class="hero-wrapper">
  <div class="hero-bg">
    <Image
      src={heroImg}
      width={1920}
      height={1080}
      format="webp"
      quality="80"
      alt="Consultorio clínico profesional"
      class="hero-img-parallax"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-overlay-desktop d-none d-md-block"></div>
    <div class="hero-overlay-mobile d-block d-md-none"></div>
  </div>

  <div class="container relative-z">
    <div class="row">
      <div class="col-lg-10 col-xl-8 animate-fade-in-up">
        <h1 class="hero-title">
          {heroData.title1} 
          <span class="text-accent italic animate-pulse-soft">
            {heroData.titleEmphasis}
          </span>
        </h1>

        <p class="hero-description">
          {heroData.description}
        </p>

        <div class="hero-actions">
          <button id="hero-cta-consulta" class="btn-boutique">
            {heroData.ctaPrimary}
          </button>

          <button id="hero-cta-metodologia" class="btn-text-link group">
            <span class="border-bottom-accent">
              {heroData.ctaSecondary}
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 -960 960 960" fill="currentColor">
              <path d="M647-440H160v-80h487L423-744l57-56 320 320-320 320-57-56 224-224Z"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-wrapper {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: var(--primary); 
  }

  .hero-img-parallax {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Bajamos un poco más la oscuridad para que la foto respire */
    filter: brightness(0.8) contrast(1.1); 
    transform: scale(1.1);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

 .hero-overlay-desktop {
    position: absolute;
    inset: 0;
    
    background: linear-gradient(
      to right, 
      var(--primary) 0%, 
      rgba(10, 26, 47, 0.9) 30%, 
      rgba(10, 26, 47, 0) 80%
    );
  }

  .hero-overlay-mobile {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top, 
      var(--primary) 35%, 
      rgba(10, 26, 47, 0.4) 100%
    );
  }

  .relative-z { position: relative; z-index: 20; }

  .hero-title {
    font-family: 'Lora', serif;
    font-size: clamp(2.4rem, 6.5vw, 4rem);
    color: white;
    line-height: 1.15;
    font-weight: 500;
    text-shadow: 0 4px 15px rgba(0,0,0,0.4);
  }

  .text-accent { color: var(--accent); }

  .hero-description {
    font-family: 'Inter', sans-serif;
    margin-top: 1.5rem;
    font-size: 1.15rem;
    color: rgba(255, 255, 255, 0.9);
    max-width: 580px;
    line-height: 1.7;
    text-wrap: balance; /* Evita viudas en el texto */
  }
  
  .hero-actions {
    margin-top: 2.5rem;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .btn-boutique {
    background-color: var(--accent);
    color: var(--primary);
    padding: 1.1rem 2.2rem;
    border: none;
    border-radius: 4px;
    font-weight: 700;
    transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 10px 25px rgba(0,0,0,0.3);
  }

  .btn-boutique:hover {
    background-color: white;
    transform: translateY(-4px);
  }

  .btn-text-link {
    background: transparent;
    border: none;
    color: white;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-weight: 600;
    transition: 0.3s;
    text-decoration: none;
  }

  .border-bottom-accent {
    border-bottom: 2px solid var(--accent);
    padding-bottom: 3px;
    transition: 0.3s;
  }

  .btn-text-link:hover .border-bottom-accent { 
    border-color: white; 
  }

  .animate-fade-in-up {
    animation: fadeInUp 1.2s ease-out forwards;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(40px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes pulse-soft {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.8; }
  }

  .animate-pulse-soft { animation: pulse-soft 3.5s infinite; }

  @media (max-width: 768px) {
    .hero-actions { 
      flex-direction: column; 
      align-items: stretch;
      gap: 1.2rem;
    }
    .hero-title { font-size: 2.3rem; }
    .btn-text-link { justify-content: center; }
  }
</style>

<script>
  const setupHero = () => {
    const img = document.querySelector(".hero-img-parallax");
    
    if (img instanceof HTMLElement) {
      window.addEventListener("scroll", () => {
        const scrolled = window.scrollY;
        // Limitar el cálculo para no saturar el procesador
        if (scrolled < window.innerHeight) {
          img.style.transform = `translateY(${scrolled * 0.15}px) scale(1.1)`;
        }
      }, { passive: true });
    }
  };

  setupHero();
</script>