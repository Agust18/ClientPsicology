---
import { Image } from "astro:assets";
import heroImg from "../../assets/images/hero.jpg";
import { heroData } from "../../data/hero.js";
// import heroVideo from "../../assets/videos/hero.mp4";
---

<section id="inicio" class="hero-wrapper">
  <div class="hero-bg">
    <video
      id="heroVideo"
      class="hero-video"
      autoplay
      muted
      loop
      playsinline
      poster="/images/hero.jpg"></video>
    <!-- <Image
      src={heroImg}
      width={1920}
      height={1080}
      format="webp"
      quality="80"
      alt="Consultorio clínico profesional"
      class="hero-img-parallax"
      loading="eager"
      fetchpriority="high"
    /> -->

    <div class="hero-overlay"></div>
  </div>

  <div class="container hero-container">
    <div class="row justify-content-start">
      <!--columna con alineación real -->
      <div class="col-12 col-lg-7 hero-content fade-up">
        <h1 class="hero-title">
          {heroData.title1}
          <span class="text-accent italic animate-pulse-soft">
            {heroData.titleEmphasis}
          </span>
        </h1>

        <p class="hero-description">
          {heroData.description}
        </p>

        <div class="hero-actions">
          <button class="btn-boutique">
            {heroData.ctaPrimary}
          </button>

          <button class="btn-text-link">
            <span class="border-bottom-accent">
              {heroData.ctaSecondary}
            </span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 -960 960 960"
              fill="currentColor"
            >
              <path
                d="M647-440H160v-80h487L423-744l57-56 320 320-320 320-57-56 224-224Z"
              ></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-wrapper {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: var(--primary);
    padding-top: 5rem;
  }

  /* BACKGROUND */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;

    overflow: hidden;
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
    height: 100%;
  }

  /* .hero-img-parallax {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.75) contrast(1.1);
    transform: scale(1.1);
    transition: transform 0.2s ease-in-out;
  } */

  .hero-video {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 110%;
    height: 110%;
    object-fit: cover;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 1.2s ease;
    filter: brightness(0.7) contrast(1.1);
  }

  /* cuando carga */
  .hero-video.loaded {
    opacity: 1;
  }

  /* ANIMACIÓN TEXTO */
  .fade-up {
    opacity: 0;
    transform: translateY(30px);
    animation: fadeUp 1s ease forwards;
  }

  @keyframes fadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* OVERLAY UNIFICADO (mejor control) */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      var(--primary) 0%,
      rgba(10, 26, 47, 0.85) 30%,
      rgba(10, 26, 47, 0.2) 100%
    );
  }

  /* CONTAINER */
  .hero-container {
    position: relative;
    z-index: 2;
    padding: 100px;
  }

  /*evita que Bootstrap centre  raro */
  .hero-content {
    text-align: left;
    background-color: rgba(10, 26, 47, 0.01);
    max-width: 700px;
  }

  /* TITULO */
  .hero-title {
    font-family: "Lora", serif;
    font-size: clamp(2.1rem, 5vw, 4.5rem);
    color: white;
    line-height: 1.1;
    font-weight: 415;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
    text-shadow: 0 8px 30px rgba(0, 0, 0, 0.5);
    letter-spacing: -0.025em;
    margin-bottom: 1.2rem;
    line-height: 1.05;
  }

  /* TEXTO */
  .hero-description {
    margin-top: 1.5rem;
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.9);
    max-width: 580px;
    line-height: 1.7;
    margin-block: 1rem;
    font-size: clamp(1.05rem, 1.2vw, 1.2rem);
    color: rgba(255, 255, 255, 0.85);
    max-width: 560px;
    line-height: 1.6;
    margin-top: 1rem;
  }

  /* ACTIONS */
  .hero-actions {
    margin-top: 2.5rem;
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 2.2rem;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* BOTÓN PRINCIPAL */
  .btn-boutique {
    background: var(--accent);
    color: var(--primary);
    padding: 1rem 2rem;
    border: none;
    border-radius: 6px;
    font-weight: 700;
    transition: 0.3s;
    cursor: pointer;
  }

  .btn-boutique:hover {
    transform: translateY(-3px);
    background: white;
  }

  .btn-text-link {
    background: transparent;
    color: white;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    animation: asx 1s;
    cursor: pointer;
    font-weight: 600;
    border-radius: 10px;
    border: 1px solid var(--accent);
  }

  .btn-text-link:hover {
    transform: translateY(-5px);
  }

  /* MOBILE */
  @media (max-width: 768px) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-container {
      padding: 1.5rem;
    }

    .hero-overlay {
      background: rgba(10, 26, 47, 0.75);
    }
    .hero-title,
    .hero-description {
      text-align: center;
    }

    .hero-content {
      padding: 1.5rem;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-actions {
      flex-direction: column;
    }

    .btn-text-link {
      justify-content: center;
    }
  }
</style>

<script>
  const setupHero = () => {
    const img = document.querySelector(".hero-img-parallax");

    if (img instanceof HTMLElement) {
      window.addEventListener(
        "scroll",
        () => {
          const scrolled = window.scrollY;
          // Limitar el cálculo para no saturar el procesador
          if (scrolled < window.innerHeight) {
            img.style.transform = `translateY(${scrolled * 0.15}px) scale(1.1)`;
          }
        },
        { passive: true },
      );
    }
  };

  setupHero();
</script>

<script is:inline>
  const video = document.getElementById("heroVideo");

  if (video) {
    const isMobile = window.innerWidth <= 768;

    video.src = isMobile
      ? "/videos/hero-mobile.mp4"
      : "/videos/hero-desktop.mp4";

    // fade cuando carga
    video.addEventListener("loadeddata", () => {
      video.classList.add("loaded");
    });
  }
</script>
