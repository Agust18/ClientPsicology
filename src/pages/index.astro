---
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import Banner from "../components/sections/Banner.astro";
import Enfoque from "../components/sections/Enfoque.astro";
import Beneficios from "../components/sections/Beneficios.astro";
import Caracteristicas from "../components/sections/Caracteristicas.astro";
import PacienteInternacionales from "../components/sections/PacientesInternacionales.astro";
import ComoTrabajamos from "../components/sections/ComoTrabajamos.astro";
import Diferenciales from "../components/sections/Diferenciales.astro";
import Footer from "../components/layout/Footer.astro";
import Equipo from "../components/sections/Equipo.astro";
import Testimonios from "../components/sections/Testimonios.astro";
import FQ from "../components/sections/FQ.astro";
import Contacto from "../components/sections/Contacto.astro";
---

<Layout>
  <Header />

  <HeroSection />
  <!-- 💥 impacto + promesa -->
  <Banner />
  <!-- 💡 refuerzo rápido (autoridad o diferencial) -->

  <Beneficios />
  <!-- ❤️ QUÉ gano yo (emocional) -->
  <Diferenciales />
  <!-- 🧠 por qué ustedes vs otros -->

  <Enfoque />
  <!-- 📐 cómo piensan (baja objeciones) -->
  <Caracteristicas />
  <!-- ⚙️ cómo funciona (detalle) -->

  <PacienteInternacionales />
  <!-- 🌍 expansión (solo si aplica al usuario) -->

  <ComoTrabajamos />
  <!-- 🧭 proceso claro (reduce fricción) -->

  <Equipo />
  <!-- 👨‍⚕️ confianza humana -->
  <Testimonios />
  <!-- 🗣️ prueba social -->

  <FQ />
  <!-- ❓ objeciones finales -->

  <Contacto />
  <!-- 🎯 CTA fuerte -->
  <Footer />
</Layout>
