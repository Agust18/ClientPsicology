---
// import { Image } from "astro:assets";
// import heroImg from "../../assets/images/hero.jpg";
import { heroData } from "../../data/hero.js";
// import heroVideo from "../../assets/videos/hero.mp4";
---

<section class="hero-wrapper" id="hero-section">
  <div class="hero-bg">
    <video
      id="heroVideo"
      class="hero-video"
      autoplay
      muted
      loop
      playsinline
      poster="/assets/images/hero.jpg"></video>
    <!-- <Image
      src={heroImg}
      width={1920}
      height={1080}
      format="webp"
      quality="80"
      alt="Consultorio clínico profesional"
      class="hero-img-parallax"
      loading="eager"
      fetchpriority="high"
    /> -->

    <div class="hero-overlay"></div>
  </div>

  <div class="container hero-container">
    <div class="row justify-content-start">
      <!--columna con alineación real -->
      <div class="col-12 col-lg-7 hero-content">
        <h1 class="title-display hero-title">
          {heroData.title1}
          <span class="text-accent italic animate-pulse-soft">
            {heroData.titleEmphasis}
          </span>
        </h1>

        <p class="text-lead hero-description">
          {heroData.description}
        </p>

        <div class="hero-actions">
          <a href="#contacto" class="btn-boutique">
            {heroData.ctaPrimary}
          </a>

          <a href="#dispositivo" class="btn-text-link">
            {heroData.ctaSecondary}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-wrapper {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: var(--primary);

    /* AJUSTE: Quitamos el padding-top fijo y usamos padding vertical 
       esto asegura que el contenido nunca toque los bordes */
    padding-block: 2rem;
  }

  /* BACKGROUND */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
    height: 100%;
  }

  /* .hero-img-parallax {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.75) contrast(1.1);
    transform: scale(1.1);
    transition: transform 0.2s ease-in-out;
  } */

  .hero-video {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 105%;
    height: 105%;
    object-fit: cover;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 1.2s ease;
    filter: brightness(0.2) contrast(1);
    /* Le dice a la placa de video que se prepare para mover este elemento */
    will-change: transform;
    /* Suaviza los saltos del scroll del mouse */
    transition: transform 0.15s ease-out;
  }

  /* cuando carga */
  .hero-video.loaded {
    opacity: 1; /* carga el video con opacidad */
    will-change: auto; /* deja de indicarle a la placa que se prepare */
    transition: opacity 1s ease; /*1s para que cargue el video*/
  }

  /* OVERLAY UNIFICADO (mejor control) */
  .hero-overlay {
    position: absolute;
    inset: 0;
    /* Degradado más inteligente: oscuro abajo y a la izquierda para legibilidad */
    background: linear-gradient(
      to bottom right,
      rgba(5, 10, 18, 0.8) 0%,
      rgba(5, 10, 18, 0.4) 50%,
      rgba(5, 10, 18, 0.2) 100%
    );
  }

  /* CONTAINER */
  .hero-container {
    position: relative;
    z-index: 2;
    padding-inline: clamp(1.5rem, 5vw, 4rem);
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: left;
  }

  /*evita que Bootstrap centre  raro */
  .hero-content {
    max-width: 750px;
    /* Evitamos el center forzado si queremos mantener estética elegante */
    text-align: left;
  }

  /* TITULO */
  .hero-title {
    font-size: clamp(
      2.2rem,
      6vw,
      4.5rem
    ); /* Un pelín más chico el mínimo para iPhone SE */
    line-height: 1.1;
    text-wrap: balance; /* Crucial para evitar cortes feos */
  }

  .hero-description {
    max-width: 580px;
    font-size: clamp(1rem, 2vw, 1.4rem);
    color: rgba(255, 255, 255, 0.9);
    text-wrap: pretty;
    margin-top: 1.5rem;
  }

  /* ACTIONS */
  .hero-actions {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1.5rem;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    flex-wrap: nowrap; /* Forzamos que no bajen en PC */
  }

  /* BOTÓN PRIMARIO (El de color) */
  .btn-boutique {
    background-color: var(
      --accent
    ); /* Asegúrate que esta variable tenga el color */
    color: var(--primary); /* Texto oscuro sobre el color */
    padding: 0 2.5rem;
    min-height: 54px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--accent);
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: all 0.4s ease;
    cursor: pointer;
    white-space: nowrap;
  }

  .btn-boutique:hover {
    background-color: white;
    border-color: white;
    color: var(--primary);
    transform: translateY(-3px);
  }

  /* BOTÓN SECUNDARIO (El transparente/border) */
  .btn-text-link {
    background: transparent;
    color: white;
    padding: 0 2.5rem;
    min-height: 54px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.4);
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    backdrop-filter: blur(5px);
    transition: all 0.4s ease;
    cursor: pointer;
    white-space: nowrap;
  }

  .btn-text-link:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: white;
    color: white;
  }

  /* MOBILE */
  @media (max-width: 768px) {
    .hero-wrapper {
      /* Evita que el hero se corte en pantallas pequeñas */
      padding-block: 6rem 4rem;
      height: auto;
      min-height: 100dvh;
    }

    .hero-content {
      text-align: center; /* Centramos todo el bloque */
      margin: 0 auto;
    }

    .hero-actions {
      justify-content: center; /* Centra los botones horizontalmente */
      flex-direction: column; /* Apila en móviles chicos */
      align-items: center;
      gap: 1rem;
      width: 100%;
    }

    .btn-boutique,
    .btn-text-link {
      width: 100%; /* Ocupan el ancho disponible */
      max-width: 320px; /* Pero no son infinitos */
      padding: 0 1rem; /* Menos padding interno para que entre el texto */
    }
    .hero-overlay {
      /* En móvil oscurecemos más para compensar pantallas con mucho brillo */
      background: rgba(5, 10, 18, 0.6);
    }

    .hero-title {
      /* Achicamos un poco más para que no empuje todo hacia abajo */
      font-size: clamp(2rem, 8vw, 2.5rem);
      text-align: center;
    }

    .hero-description {
      text-align: center;
      margin-inline: auto;
    }

    .hero-container {
      padding: 1.5rem;
    }
  }
  /* Para pantallas extremadamente pequeñas (iPhone SE viejo) */
  @media (max-width: 360px) {
    .btn-boutique,
    .btn-text-link {
      font-size: 0.75rem;
      min-height: 48px;
    }

    .hero-title {
      font-size: 1.8rem;
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  const setupHeroVisuals = () => {
    const content = document.querySelector(".hero-container");
    if (!content) return;

    // Usamos fromTo para asegurar que GSAP tome el control total del estado A y B
    const tl = gsap.timeline({ paused: true });

    tl.fromTo(
      ".hero-title",
      { y: 40, opacity: 0 },
      { y: 0, opacity: 1, duration: 1.2, ease: "power4.out" },
    )
      .fromTo(
        ".hero-description",
        { y: 20, opacity: 0 },
        { y: 0, opacity: 1, duration: 1, ease: "power3.out" },
        "-=0.8",
      )
      .fromTo(
        ".hero-actions a",
        { y: 20, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.8, stagger: 0.15, ease: "power3.out" },
        "-=0.6",
      );

    // Guardamos la animación en window para que el Script 2 pueda darle PLAY
    (window as any).heroReveal = tl;
  };

  setupHeroVisuals();
  document.addEventListener("astro:after-swap", setupHeroVisuals);
</script>

<script>
  (function () {
    const video = document.getElementById(
      "heroVideo",
    ) as HTMLVideoElement | null;

    const startReveal = () => {
      const reveal = (window as any).heroReveal;
      if (reveal && reveal.progress() === 0) {
        // Si no ha empezado...
        if (video) video.classList.add("loaded");
        reveal.play();
      }
    };

    if (video) {
      const isMobile = window.innerWidth <= 768;
      video.src = isMobile
        ? "/assets/videos/hero-mobile.mp4"
        : "/assets/videos/hero-desktop.mp4";

      // Intentar disparar cuando el video esté listo
      video.addEventListener("loadeddata", startReveal);

      // Si el video falla (error 404, etc), mostrar texto igual
      video.addEventListener("error", startReveal);

      // Si el video ya estaba en caché, loadeddata no siempre salta
      if (video.readyState >= 3) startReveal();
    }

    // EL SALVAVIDAS: Si en 1 segundo nada apareció, lo forzamos.
    // Esto arregla el problema de que el texto "desaparezca" para siempre.
    setTimeout(startReveal, 1000);
  })();
</script>
