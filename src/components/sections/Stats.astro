<section class="stats-section">
    <div class="container">
        <div class="stats-grid">
            <!-- Métrica 1 -->
            <div class="stat-item">
                <div class="stat-value">
                    <span class="counter" data-target="15">0</span>+
                </div>
                <div class="stat-label">Años de Trayectoria</div>
            </div>

            <div class="stat-divider"></div>

            <!-- Métrica 2 -->
            <div class="stat-item">
                <div class="stat-value">
                    <span class="counter" data-target="1000">0</span>+
                </div>
                <div class="stat-label">Pacientes Atendidos</div>
            </div>

            <div class="stat-divider"></div>

            <!-- Métrica 3 -->
            <div class="stat-item">
                <div class="stat-value">
                    <span class="counter" data-target="8">0</span>
                </div>
                <div class="stat-label">Especialidades Clínicas</div>
            </div>
        </div>
    </div>
</section>

<style>
    .stats-section {
        background-color: #03070d;
        padding: 5rem 0;

        /* 1. Elevamos la sección para que la sombra sea visible sobre el Hero */
        position: relative;
        z-index: 10;

        /* 2. Subimos la sección un poco para que monte sobre el final del Hero */
        margin-top: -30px;

        /* 3. El borde fino es clave, pero vamos a hacerlo sutil */
        border-top: 0.5px solid rgba(212, 175, 55, 0.3); /* Un toque dorado */

        /* 4. Sombra proyectada hacia ARRIBA */
        /* El -40px es lo que la desplaza hacia el Hero */
        /* El -20px es el difusor de la sombra */
        /* El 0.5 es la opacidad de la sombra */
        /* el primer 0 es la posicion en X*/
        box-shadow: 0 -30px 60px rgba(0, 0, 0, 0.5);
        box-shadow: 0 25px 50px -15px rgba(180, 147, 90, 0.6);
    }

    .stats-grid {
        display: flex;
        justify-content: space-around;
        align-items: center;
        gap: 2rem;
    }

    .stat-item {
        text-align: center;
        flex: 1;

        font-weight: 400;
        line-height: 1;
        margin-bottom: 0.5rem;
    }

    .stat-value {
        font-size: clamp(2.5rem, 4vw, 3.5rem);
        color: var(--accent); /* Dorado */
        font-weight: 400;
        line-height: 1;
        margin-bottom: 0.5rem;
    }

    .stat-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        color: #888;
        letter-spacing: 0.2em;
        font-weight: 500;
    }

    .stat-divider {
        width: 1px;
        height: 60px;
        background: linear-gradient(
            to bottom,
            transparent,
            rgba(212, 175, 55, 0.5),
            transparent
        );
    }

    @media (max-width: 768px) {
        .stats-grid {
            flex-direction: row;
            gap: 1rem;
        }
        .stat-divider {
            display: flex;
            height: 60px;
            width: 1px;
        }

        .stat-value {
            font-size: 2rem;
        }
        .stat-label {
            font-size: 0.5rem;
        }
    }
</style>

<script>
    const startCounters = () => {
        const counters = document.querySelectorAll(".counter");
        const speed = 220; // Cuanto más alto, más lento

        const animate = (counter: HTMLElement) => {
            const target = +counter.getAttribute("data-target")!;
            const count = +counter.innerText;
            const increment = target / speed;

            if (count < target) {
                counter.innerText = Math.ceil(count + increment).toString();
                setTimeout(() => animate(counter), 10);
            } else {
                counter.innerText = target.toString();
            }
        };

        // Intersection Observer para que la animación empiece cuando el usuario llega a la sección
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        const targetCounter = entry.target as HTMLElement;
                        animate(targetCounter);
                        observer.unobserve(targetCounter);
                    }
                });
            },
            { threshold: 0.5 },
        );

        counters.forEach((c) => observer.observe(c));
    };

    // Iniciar al cargar
    startCounters();
    // Reiniciar si usas View Transitions de Astro
    document.addEventListener("astro:after-swap", startCounters);
</script>
