---
import { DiferencialesData } from "../../data/Diferenciales.js";
---

<section class="diff-section">
    <div class="container">
        <div class="diff-header">
            <span class="diff-subtitle">Nuestra Propuesta de Valor</span>
            <h2 class="section-title">
                ¿Por qué elegir <span>Vínculo Vital?</span>
            </h2>
        </div>

        <div class="diff-grid">
            {
                DiferencialesData.map((item) => (
                    <div class="diff-card">
                        <div class="diff-number">{item.id}</div>
                        <div class="diff-content">
                            <h3 class="diff-title">{item.titulo}</h3>
                            <p class="diff-text">{item.descripcion}</p>
                            <div class="diff-highlight">
                                <span>{item.resaltado}</span>
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>

        <div class="cta-kinetic-wrapper">
            <a href="#contacto" class="kinetic-bar">
                <!-- Capas de fondo para profundidad -->
                <div class="glass-layer"></div>
                <div class="glow-point"></div>

                <div class="kinetic-content">
                    <div class="text-stack">
                        <span class="top-label">Comenzar ahora</span>
                        <span class="main-text">Dar el primer paso</span>
                    </div>

                    <div class="icon-orbit">
                        <div class="orbit-ring"></div>
                        <svg
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                        >
                            <line x1="7" y1="17" x2="17" y2="7"></line>
                            <polyline points="7 7 17 7 17 17"></polyline>
                        </svg>
                    </div>
                </div>
            </a>
        </div>
    </div>
</section>
<style>
    .diff-section {
        background-color: #03070d;
        padding: clamp(4rem, 8vw, 8rem) 1.5rem;
        color: white;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
    }

    /* 🔥 HEADER */
    .diff-header {
        margin-bottom: clamp(3rem, 6vw, 5rem);
        max-width: 1000px;
    }

    /* SUBTÍTULO */
    .diff-subtitle {
        color: #c5a47e;
        text-transform: uppercase;
        letter-spacing: 0.35em;
        font-size: 0.75rem;
        display: block;
        margin-bottom: 1.2rem;
        opacity: 0.9;
    }

    /* 🔥 TÍTULO PRO */
    .section-title {
        font-family: "Lora", serif;
        font-size: clamp(2.4rem, 5vw, 4rem);
        line-height: 1.1;
        letter-spacing: -0.6px;
        max-width: 900px;
        text-wrap: balance;
    }

    /* 🔥 SOLO afecta el nombre */
    .section-title span {
        color: #c5a47e;
        font-style: italic;
        position: relative;
    }

    .section-title span::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: 4px;
        width: 100%;
        height: 1px;
        background: rgba(197, 164, 126, 0.5);
    }

    /* GRID */
    .diff-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
        gap: clamp(1.5rem, 3vw, 2rem);
    }

    /* CARDS */
    .diff-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        padding: clamp(2rem, 4vw, 3rem);
        display: flex;
        flex-direction: column;
        gap: 1.5rem;

        transition: all 0.4s ease;
    }

    .diff-card:hover {
        transform: translateY(-6px);
        border-color: rgba(197, 164, 126, 0.3);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    }

    /* TEXTO */
    .diff-number {
        font-family: "Lora", serif;
        font-size: 1.1rem;
        color: #c5a47e;
        font-weight: 600;
        letter-spacing: 0.2em;
    }

    .diff-title {
        font-family: "Lora", serif;
        font-size: clamp(1.4rem, 2vw, 1.8rem);
        line-height: 1.3;
    }

    .diff-text {
        font-size: 1.05rem;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.7);
    }

    .diff-highlight {
        margin-top: auto;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(197, 164, 126, 0.25);
        color: #c5a47e;
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    /* CTA */
    .cta-kinetic-wrapper {
        margin-top: clamp(4rem, 8vw, 7rem);
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .kinetic-bar {
        position: relative;
        display: block;
        width: 100%;
        max-width: 450px;
        padding: 1.2rem 2rem;
        text-decoration: none;
        overflow: hidden;
        border-radius: 20px;
        transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    /* Glass */
    .glass-layer {
        position: absolute;
        inset: 0;
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(15px);
        z-index: 1;
    }

    .glow-point {
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(
            circle,
            rgba(197, 164, 126, 0.15) 0%,
            transparent 70%
        );
        z-index: 2;
        transition: transform 0.5s ease;
    }

    .kinetic-content {
        position: relative;
        z-index: 3;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .text-stack {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .top-label {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: #c5a47e;
        font-weight: 600;
        opacity: 0.8;
    }

    .main-text {
        font-size: 1.2rem;
        color: #fff;
        font-weight: 500;
        font-family: "Lora", serif;
    }

    /* ICON */
    .icon-orbit {
        position: relative;
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #c5a47e;
        color: #03070d;
        border-radius: 14px;
        transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .orbit-ring {
        position: absolute;
        inset: -5px;
        border: 1px solid rgba(197, 164, 126, 0.3);
        border-radius: 18px;
        transition: all 0.5s ease;
    }

    /* HOVER */
    .kinetic-bar:hover {
        transform: scale(1.03);
        border-color: rgba(197, 164, 126, 0.5);
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
    }

    .kinetic-bar:hover .icon-orbit {
        transform: rotate(45deg);
        border-radius: 50%;
        background: #fff;
    }

    .kinetic-bar:hover .orbit-ring {
        inset: -10px;
        opacity: 0;
        transform: scale(1.2);
    }

    .kinetic-bar:hover .glow-point {
        transform: translate(10%, 10%);
    }

    .kinetic-bar:active {
        transform: scale(0.98);
    }

    /* 📱 MOBILE */
    @media (max-width: 768px) {
        .diff-section {
            padding: 4rem 1rem;
        }

        .diff-header {
            text-align: center;
            margin-inline: auto;
        }

        .section-title {
            font-size: clamp(1.9rem, 6vw, 2.5rem);
        }

        .diff-card {
            padding: 2rem;
        }
    }

    /* 📱 MINI */
    @media (max-width: 480px) {
        .main-text {
            font-size: 1.05rem;
        }

        .kinetic-bar {
            max-width: 100%;
        }
    }

    /* 🖥️ DESKTOP GRANDE */
    @media (min-width: 1200px) {
        .diff-header {
            max-width: 1100px;
            margin-left: 3rem;
        }

        .diff-header h2 {
            text-align: left;
            padding-left: 3.5rem;
        }
        .diff-header span {
            padding-left: 2rem;
        }

        .diff-subtitle {
            padding-left: 3.5rem;
        }

        .section-title {
            max-width: 1000px;
        }
    }
</style>
