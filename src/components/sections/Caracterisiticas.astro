---
import { ejesPrincipales, especialidades } from "../../data/Caracteristicas.js";
---

<section id="dispositivo" class="complexity-section relative overflow-hidden">
    <!-- Subtle Background Glows -->
    <div class="bg-glow bg-glow-1"></div>
    <div class="bg-glow bg-glow-2"></div>

    <div class="content-wrapper relative z-10">
        <!-- HEADER PRINCIPAL PREMIUM -->
        <header class="premium-header">
            <div class="premium-badge-wrapper gsap-fade-up">
                <div class="premium-badge">
                    <span class="pulse-dot"></span>
                    Características del servicio
                </div>
            </div>

            <div class="header-main-content">
                <h2 class="premium-title gsap-fade-up">
                    Dispositivo Interdisciplinario <br />
                    de <em class="text-accent">Alta Complejidad</em>
                </h2>

                <div class="header-text-layout">
                    <div class="main-desc-block gsap-fade-up">
                        <p class="lead-paragraph">
                            Atención ambulatoria intensiva en contexto
                            domiciliario. Somos un equipo interdisciplinario
                            orientado al abordaje de pacientes que requieren un
                            nivel de atención superior al ambulatorio
                            tradicional, pero que no pueden o no desean ser
                            institucionalizados.
                        </p>
                    </div>

                    <div class="secondary-desc-block gsap-fade-up">
                        <div class="accent-line"></div>
                        <p class="logic-paragraph">
                            Nuestro modelo traslada la lógica y el rigor de una
                            institución de salud al entorno del paciente,
                            integrando evaluación médica, seguimiento clínico
                            intensivo y abordaje psicológico sistémico en un
                            mismo dispositivo.
                        </p>
                    </div>
                </div>
            </div>
        </header>

        <!-- FILOSOFÍA Y ESPECIALIDADES -->
        <div class="philosophy-grid gsap-bento">
            <div class="philosophy-card glass-panel">
                <div class="icon-wrap">
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="text-accent"
                        ><polygon points="12 2 2 7 12 12 22 7 12 2"
                        ></polygon><polyline points="2 17 12 22 22 17"
                        ></polyline><polyline points="2 12 12 17 22 12"
                        ></polyline></svg
                    >
                </div>
                <h3>No trabajamos desde la fragmentación</h3>
                <p>
                    Diseñamos intervenciones a medida, organizadas en torno a la
                    singularidad de cada caso. Contamos con un equipo de
                    profesionales de primer nivel orientado al abordaje
                    integral.
                </p>
            </div>
            <div
                class="specialties-wrap glass-panel flex flex-col justify-center"
            >
                <h4 class="specialties-title">Nuestras Especialidades</h4>
                <div class="specialties-list">
                    {
                        especialidades.map((item) => (
                            <span class="specialty-tag gsap-tag">{item}</span>
                        ))
                    }
                </div>
            </div>
        </div>

        <!-- LOS 4 EJES ESTRUCTURANTES -->
        <div class="ejes-container">
            <div class="ejes-header-wrap text-center gsap-fade-up">
                <span class="eyebrow">Fundamentos</span>
                <h3 class="ejes-title">
                    Estructurado sobre 4 ejes coordinados
                </h3>
            </div>
            <div class="ejes-grid">
                {
                    ejesPrincipales.map((eje) => (
                        <div class="eje-item glass-panel hover-lift gsap-eje">
                            <div class="eje-header">
                                <span class="eje-number">{eje.num}</span>
                                <h4>{eje.titulo}</h4>
                            </div>
                            <p class="text-lead">{eje.descripcion}</p>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- ÁREA INTERNACIONAL -->
        <div
            class="international-zone glass-panel highlight-border gsap-fade-up"
        >
            <div class="intl-header">
                <div class="intl-title-group">
                    <span class="intl-badge">Global Coverage</span>
                    <h3>Área de Pacientes Internacionales</h3>
                </div>
                <p class="intl-lead">
                    Servicio orientado al seguimiento online de familias de
                    habla hispana que residen fuera del país (EE.UU., Europa e
                    Hispanoamérica) o en contextos de movilidad internacional.
                </p>
            </div>

            <div class="intl-details">
                <div class="intl-column">
                    <h4>Diferenciales principales</h4>
                    <ul class="custom-list">
                        <li class="gsap-li">
                            <strong>Confidencialidad:</strong> Alto estándar en el
                            manejo de la información y resguardo en cada instancia.
                        </li>
                        <li class="gsap-li">
                            <strong>Comprensión del Contexto:</strong> Entendemos
                            las dificultades de acceso a salud en el exterior (costos
                            y fragmentación).
                        </li>
                        <li class="gsap-li">
                            <strong>Respaldo Clínico:</strong> Criterios alineados
                            a estándares de instituciones de referencia como el <strong
                                >Hospital Austral</strong
                            >.
                        </li>
                        <li class="gsap-li">
                            <strong>Acceso Virtual:</strong> Consultas con especialistas
                            de primer nivel en Argentina sin necesidad de traslados.
                        </li>
                    </ul>
                </div>
                <div class="intl-column recipients glass-panel-inner">
                    <h4>Destinatarios</h4>
                    <p class="mb-4 text-gray-300">
                        Personas y familias de habla hispana que:
                    </p>
                    <ul class="custom-list">
                        <li class="gsap-li">
                            Residen en Estados Unidos, Europa e Hispanoamérica.
                        </li>
                        <li class="gsap-li">
                            Se encuentran en procesos migratorios o de
                            expatriación.
                        </li>
                        <li class="gsap-li">
                            Requieren seguimiento clínico con un profesional de
                            referencia.
                        </li>
                        <li class="gsap-li">
                            Buscan un espacio terapéutico en su idioma y con
                            comprensión cultural.
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    :root {
        --bg-color: #03070d;
        --accent: #c5a47e;
        --accent-glow: rgba(197, 164, 126, 0.15);
        --text-main: #f3f4f6;
        --text-muted: #9ca3af;
        --glass-bg: rgba(255, 255, 255, 0.02);
        --glass-border: rgba(255, 255, 255, 0.06);
    }

    .complexity-section {
        background-color: var(--bg-color);
        color: var(--text-main);
        padding: clamp(4rem, 8vw, 6rem) 5%;
        font-family: "Inter", sans-serif;
        position: relative;
    }

    /* Background Glows */
    .bg-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(120px);
        z-index: 0;
        pointer-events: none;
    }
    .bg-glow-1 {
        top: -10%;
        left: -10%;
        width: 50vw;
        height: 50vw;
        background: radial-gradient(
            circle,
            var(--accent-glow) 0%,
            transparent 70%
        );
    }
    .bg-glow-2 {
        bottom: 10%;
        right: -10%;
        width: 40vw;
        height: 40vw;
        background: radial-gradient(
            circle,
            var(--accent-glow) 0%,
            transparent 70%
        );
    }

    .content-wrapper {
        max-width: 1280px;
        margin: 0 auto;
    }

    /* Typography Utilities */
    .text-accent {
        color: var(--accent);
    }
    .eyebrow {
        color: var(--accent);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        font-size: 0.8rem;
        display: inline-block;
        margin-bottom: 1rem;
    }

    /* Glassmorphism Panels */
    .glass-panel {
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: 24px;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        padding: clamp(2rem, 4vw, 3.5rem);
    }
    .glass-panel-inner {
        background: rgba(0, 0, 0, 0.2);
        border: 1px solid var(--glass-border);
        border-radius: 16px;
        padding: 2rem;
    }

    /* Philosophy & Specialties Bento */
    .philosophy-grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 2rem;
        margin-bottom: clamp(4rem, 6vw, 6rem);
    }

    .icon-wrap {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: rgba(197, 164, 126, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.5rem;
    }

    .philosophy-card h3 {
        font-family: "Lora", serif;
        font-size: clamp(1.8rem, 3vw, 2.2rem);
        color: #ffffff;
        margin-bottom: 1rem;
        line-height: 1.2;
    }
    .philosophy-card p {
        color: var(--text-muted);
        line-height: 1.6;
        font-size: 1.1rem;
    }

    .specialties-title {
        font-size: 1rem;
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 1.5rem;
        font-weight: 600;
    }

    .specialties-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }
    .specialty-tag {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--glass-border);
        padding: 0.5rem 1rem;
        border-radius: 100px;
        font-size: 0.9rem;
        color: var(--text-main);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: default;
    }
    .specialty-tag:hover {
        background: var(--accent);
        color: var(--bg-color);
        border-color: var(--accent);
        transform: translateY(-2px);
    }

    /* 4 Axes Grid */
    .ejes-container {
        margin-bottom: clamp(4rem, 6vw, 6rem);
    }
    .ejes-header-wrap {
        margin-bottom: clamp(2rem, 4vw, 3rem);
    }
    .ejes-title {
        font-family: "Lora", serif;
        font-size: clamp(2rem, 4vw, 3rem);
        color: #ffffff;
        font-weight: 400;
    }

    .ejes-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem;
    }

    .eje-item {
        position: relative;
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
    }
    .hover-lift:hover {
        transform: translateY(-5px);
        border-color: rgba(197, 164, 126, 0.3);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    }

    .eje-header {
        display: flex;
        align-items: flex-start;
        gap: 1.25rem;
        margin-bottom: 1.5rem;
    }
    .eje-number {
        font-family: "Lora", serif;
        font-size: 2.5rem;
        color: transparent;
        -webkit-text-stroke: 1px var(--accent);
        line-height: 1;
        font-style: italic;
        min-width: 40px;
    }
    .hover-lift:hover .eje-number {
        color: var(--accent);
        -webkit-text-stroke: 0;
    }

    .eje-item h4 {
        font-size: 1.35rem;
        color: #ffffff;
        margin: 0;
        line-height: 1.3;
        font-weight: 500;
        padding-top: 0.2rem;
    }
    .eje-item .text-lead {
        color: var(--text-muted);
        line-height: 1.6;
        font-size: 1.05rem;
    }

    /* International Zone */
    .highlight-border {
        position: relative;
    }
    .highlight-border::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 24px;
        padding: 1px;
        background: linear-gradient(
            135deg,
            rgba(197, 164, 126, 0.5) 0%,
            rgba(255, 255, 255, 0.05) 100%
        );
        -webkit-mask:
            linear-gradient(#fff 0 0) content-box,
            linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        pointer-events: none;
    }

    .intl-header {
        text-align: center;
        max-width: 800px;
        margin: 0 auto clamp(2rem, 4vw, 3rem);
    }
    .intl-title-group {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }
    .intl-badge {
        background: rgba(197, 164, 126, 0.1);
        color: var(--accent);
        border: 1px solid rgba(197, 164, 126, 0.2);
        padding: 0.4rem 1rem;
        border-radius: 100px;
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }
    .intl-header h3 {
        font-family: "Lora", serif;
        font-size: clamp(2rem, 4vw, 3rem);
        color: #ffffff;
        font-weight: 400;
    }
    .intl-lead {
        font-size: 1.15rem;
        color: var(--text-muted);
        line-height: 1.6;
    }

    .intl-details {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 3rem;
        align-items: start;
    }

    .intl-column h4 {
        color: #ffffff;
        font-size: 1.3rem;
        margin-bottom: 2rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    .intl-column h4::before {
        content: "";
        display: block;
        width: 12px;
        height: 12px;
        background: var(--accent);
        border-radius: 50%;
    }

    .custom-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    .custom-list li {
        margin-bottom: 1.25rem;
        line-height: 1.6;
        position: relative;
        padding-left: 1.75rem;
        color: var(--text-muted);
        font-size: 1.05rem;
    }
    .custom-list li strong {
        color: var(--text-main);
        font-weight: 500;
    }
    .custom-list li::before {
        content: "→";
        position: absolute;
        left: 0;
        color: var(--accent);
        font-family: system-ui;
    }

    /* Responsive Design */
    @media (max-width: 1024px) {
        .philosophy-grid {
            grid-template-columns: 1fr;
        }
        .ejes-grid {
            grid-template-columns: 1fr;
        }
        .intl-details {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
    }
    @media (max-width: 768px) {
        .intro-grid {
            grid-template-columns: 1fr;
            gap: 1.5rem;
            text-align: center;
        }
        .eje-header {
            flex-direction: column;
            gap: 0.5rem;
        }
    }

    /* --- Premium Header Redesign --- */
    .premium-header {
        margin-bottom: clamp(4rem, 6vw, 6rem);
        display: flex;
        flex-direction: column;
        gap: clamp(2.5rem, 5vw, 4rem);
        max-width: 1200px;
        margin-inline: auto;
    }

    .premium-badge-wrapper {
        display: flex;
        justify-content: flex-start;
    }

    .premium-badge {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        background: rgba(197, 164, 126, 0.05);
        border: 1px solid rgba(197, 164, 126, 0.2);
        padding: 8px 20px;
        border-radius: 100px;
        color: var(--accent);
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    .pulse-dot {
        width: 6px;
        height: 6px;
        background-color: var(--accent);
        border-radius: 50%;
        box-shadow: 0 0 0 0 rgba(197, 164, 126, 0.7);
        animation: pulse 2s infinite cubic-bezier(0.66, 0, 0, 1);
    }

    @keyframes pulse {
        to {
            box-shadow: 0 0 0 10px rgba(197, 164, 126, 0);
        }
    }

    .header-main-content {
        display: flex;
        flex-direction: column;
        gap: 4rem;
    }

    .premium-title {
        font-family: "Lora", serif;
        font-size: clamp(3rem, 6vw, 5.5rem);
        line-height: 1.05;
        color: #ffffff;
        font-weight: 400;
        letter-spacing: -1px;
    }

    .premium-title em {
        font-style: normal;
        color: var(--accent);
        position: relative;
        display: inline-block;
    }

    .premium-title em::after {
        content: "";
        position: absolute;
        bottom: 8px;
        left: 0;
        width: 100%;
        height: 2px;
        background: var(--accent);
        opacity: 0.4;
    }

    .header-text-layout {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 5rem;
        align-items: start;
        margin-left: auto;
        width: 90%;
    }

    .lead-paragraph {
        font-size: 1.25rem;
        line-height: 1.8;
        color: #ffffff;
        font-weight: 300;
    }

    .secondary-desc-block {
        position: relative;
        padding-left: 2rem;
    }

    .accent-line {
        position: absolute;
        top: 0;
        left: 0;
        width: 2px;
        height: 100%;
        background: linear-gradient(
            to bottom,
            var(--accent) 0%,
            transparent 100%
        );
    }

    .logic-paragraph {
        font-size: 1.05rem;
        line-height: 1.8;
        color: rgba(255, 255, 255, 0.6);
        font-weight: 300;
    }

    @media (max-width: 1024px) {
        .header-text-layout {
            grid-template-columns: 1fr;
            width: 100%;
            gap: 3rem;
        }
        .secondary-desc-block {
            padding-left: 0;
            padding-top: 2rem;
        }
        .accent-line {
            width: 100%;
            height: 2px;
            background: linear-gradient(
                to right,
                var(--accent) 0%,
                transparent 100%
            );
        }
    }
    @media (max-width: 768px) {
        .premium-title {
            font-size: 2.5rem;
        }
        .premium-header {
            margin-bottom: 4rem;
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("astro:page-load", () => {
        // Standard fade up elements
        gsap.utils.toArray(".gsap-fade-up").forEach((el) => {
            gsap.from(el as gsap.DOMTarget, {
                y: 40,
                opacity: 0,
                duration: 1,
                ease: "power3.out",
                scrollTrigger: {
                    trigger: el as gsap.DOMTarget,
                    start: "top 85%",
                    toggleActions: "play none none reverse",
                },
            });
        });

        // Bento grid card reveal
        gsap.from(".gsap-bento > div", {
            y: 50,
            opacity: 0,
            duration: 1,
            stagger: 0.2,
            ease: "power3.out",
            scrollTrigger: {
                trigger: ".gsap-bento",
                start: "top 80%",
                toggleActions: "play none none reverse",
            },
        });

        // Specialty tags stagger
        gsap.from(".gsap-tag", {
            scale: 0.8,
            opacity: 0,
            duration: 0.6,
            stagger: 0.05,
            ease: "back.out(1.5)",
            scrollTrigger: {
                trigger: ".specialties-list",
                start: "top 85%",
                toggleActions: "play none none reverse",
            },
        });

        // Ejes Grid stagger
        gsap.from(".gsap-eje", {
            y: 50,
            opacity: 0,
            duration: 0.8,
            stagger: 0.15,
            ease: "power3.out",
            scrollTrigger: {
                trigger: ".ejes-grid",
                start: "top 80%",
                toggleActions: "play none none reverse",
            },
        });

        // International Zone Lists stagger
        gsap.utils.toArray(".intl-column").forEach((col) => {
            const items = (col as HTMLElement).querySelectorAll(".gsap-li");
            if (items.length > 0) {
                gsap.from(items, {
                    x: -20,
                    opacity: 0,
                    duration: 0.6,
                    stagger: 0.1,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: col as gsap.DOMTarget,
                        start: "top 85%",
                        toggleActions: "play none none reverse",
                    },
                });
            }
        });
    });
</script>
