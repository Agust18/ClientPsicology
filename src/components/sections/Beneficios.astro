---
import { BeneficiosData } from "../../data/Beneficios";
---

<section class="beneficios-wrapper">
    <div class="container">
        <div class="beneficios-header fade-in-up">
            <h2 class="title-display title-beneficios">
                {BeneficiosData.title}
            </h2>
            <span class="font-display italic text-accent"
                >Nuestros 4 pilares</span
            >
            <hr />
        </div>

        <div class="beneficios-grid">
            {
                BeneficiosData.items.map((item) => (
                    <div class="beneficio-card fade-in-up">
                        <div class="beneficio-content">
                            <span class="beneficio-number">0{item.id}</span>
                            <h3 class="beneficio-title">{item.title}</h3>
                            <p class="beneficio-description">
                                {item.description}
                            </p>
                        </div>
                        <div class="card-border-gradient" />
                    </div>
                ))
            }
        </div>

        <div class="cta-exclusive-container fade-in-up">
            <div class="exclusivity-frame">
                <!-- Decoración de esquinas para el look 'Boutique' -->
                <div class="corner tl"></div>
                <div class="corner br"></div>

                <div class="cta-inner-content">
                    <p class="cta-note-premium">
                        <svg
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <rect
                                x="3"
                                y="11"
                                width="18"
                                height="11"
                                rx="2"
                                ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        Comencemos su proceso
                    </p>

                    <a href="#contacto" class="cta-gate-button">
                        <span class="btn-text">Iniciar evaluación clínica</span>
                        <div class="btn-aura"></div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .beneficios-wrapper {
        background-color: #03070d;
        padding: clamp(4rem, 8vw, 8rem) 1.5rem;
        position: relative;
        overflow: hidden;
    }

    .beneficios-header {
        margin-bottom: clamp(3rem, 5vw, 5rem);
        text-align: center;
    }

    /* Ajuste de especificidad para el subtítulo */
    .beneficios-header .font-display {
        display: block;
        font-size: clamp(1.2rem, 2vw, 1.6rem);
        margin-top: 0.5rem;
        letter-spacing: 0.05em;
    }
    hr {
        /* Línea más corta y elegante */
        width: 60px;
        border: none;
        height: 1px;
        background-color: var(--accent);
        margin: 1.5rem auto 2rem;
        opacity: 0.6;
    }
    span {
        font-size: clamp(1.5rem, 2vw, 1.8rem);
    }

    .title-beneficios {
        font-size: clamp(2.2rem, 4vw, 3.2rem);
        max-width: 800px;
        margin: 0 auto;
        line-height: 1.1;
        text-wrap: balance;
    }

    /* --- GRID DINÁMICO --- */
    .beneficios-grid {
        display: grid;
        /* El min(100%, 350px) previene el desborde en pantallas muy chicas */
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
        gap: clamp(1.5rem, 3vw, 2.5rem);
    }

    /* --- CARDS --- */
    .beneficio-card {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        padding: clamp(2rem, 4vw, 3.5rem);
        position: relative;
        transition: all 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .beneficio-card:hover {
        transform: translateY(-10px);
        background: rgba(255, 255, 255, 0.04);
        border-color: rgba(255, 255, 255, 0.15);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    }
    .beneficio-number {
        display: block;
        color: var(--accent);
        font-size: 0.85rem;
        font-weight: 700;
        margin-bottom: 2rem;
        letter-spacing: 0.4em;
        opacity: 0.8;
    }

    .beneficio-title {
        font-size: 1.5rem;
        margin-bottom: 1.2rem;
        color: #fff;
        font-weight: 500;
    }

    .beneficio-description {
        color: rgba(226, 232, 240, 0.65);
        line-height: 1.8;
        font-size: 1rem;
        text-wrap: pretty;
    }

    /* --- LÍNEA DE HOVER --- */
    .card-border-gradient {
        position: absolute;
        bottom: 0;
        left: 50%;
        width: 0%;
        height: 2px;
        background: var(--accent);
        transform: translateX(-50%);
        transition: width 0.6s ease;
    }

    .beneficio-card:hover .card-border-gradient {
        width: 100%;
    }

    /* --- RESPONSIVE DESKTOP --- */
    @media (min-width: 1200px) {
        .beneficios-grid {
            /* Forzamos 2 columnas limpias en desktop para mantener el orden */
            grid-template-columns: repeat(2, 1fr);
            max-width: 1100px;
            margin: 0 auto;
        }
    }

    /* --- AJUSTES MÓVIL --- */
    @media (max-width: 768px) {
        .beneficio-card {
            text-align: center;
        }

        .beneficio-number {
            margin-bottom: 1rem;
        }
    }

    /* PANTALLAS MINI */
    @media (max-width: 360px) {
        .title-beneficios {
            font-size: 1.8rem;
        }
        .beneficios-wrapper {
            padding-inline: 1rem;
        }
    }

    .cta-exclusive-container {
        margin-top: 6rem;
        display: flex;
        justify-content: center;
        padding-bottom: 2rem;
    }

    .exclusivity-frame {
        position: relative;
        padding: 3rem 5rem;
        background: radial-gradient(
            circle at center,
            rgba(197, 164, 126, 0.05) 0%,
            transparent 70%
        );
        border-radius: 4px;
        text-align: center;
    }

    /* Esquinas decorativas tipo 'Luxury Package' */
    .corner {
        position: absolute;
        width: 20px;
        height: 20px;
        border-color: var(--accent);
        border-style: solid;
        opacity: 0.4;
        transition: all 0.6s ease;
    }
    .tl {
        top: 0;
        left: 0;
        border-width: 1px 0 0 1px;
    }
    .br {
        bottom: 0;
        right: 0;
        border-width: 0 1px 1px 0;
    }

    .exclusivity-frame:hover .corner {
        width: 40px;
        height: 40px;
        opacity: 1;
    }

    .cta-inner-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
    }

    .cta-note-premium {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: rgba(255, 255, 255, 0.5);
        font-weight: 500;
    }

    .cta-note-premium svg {
        color: var(--accent);
    }

    /* Botón Minimalista con Aura */
    .cta-gate-button {
        position: relative;
        padding: 1.2rem 3rem;
        background: transparent;
        color: #fff;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 3px;
        border: 1px solid rgba(197, 164, 126, 0.3);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 1;
    }

    .btn-aura {
        position: absolute;
        inset: 0;
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: -1;
    }

    .cta-gate-button:hover {
        color: #03070d;
        border-color: var(--accent);
        letter-spacing: 4px; /* Efecto de expansión tipográfica */
    }

    .cta-gate-button:hover .btn-aura {
        transform: scaleX(1);
        transform-origin: left;
    }

    /* Media Queries */
    @media (max-width: 768px) {
        .exclusivity-frame {
            padding: 2.5rem 1.5rem;
            width: 100%;
        }
        .cta-gate-button {
            width: 100%;
            padding: 1.2rem 1rem;
            font-size: 0.8rem;
        }
        .corner {
            display: none;
        } /* Limpiamos en móvil para evitar ruido */
    }
</style>
