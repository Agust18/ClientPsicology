---
import { BeneficiosData } from "../../data/Beneficios";
---

<section class="beneficios-wrapper" id="beneficios">
    <div class="container">
        <div class="beneficios-header fade-in-up">
            <h2 class="title-display title-beneficios">
                {BeneficiosData.title}
            </h2>
            <span class="italic text-accent">Nuestros 4 pilares</span>
            <hr />
        </div>

        <div class="beneficios-grid">
            {
                BeneficiosData.items.map((item) => (
                    <div class="beneficio-card fade-in-up">
                        <div class="beneficio-content">
                            <span class="beneficio-number">0{item.id}</span>
                            <h3 class="beneficio-title">{item.title}</h3>
                            <p class="beneficio-description">
                                {item.description}
                            </p>
                        </div>
                        <div class="card-border-gradient" />
                    </div>
                ))
            }
        </div>

        <!-- CTA -->
        <div class="cta-exclusive-container fade-in-up">
            <div class="exclusivity-frame">
                <div class="corner tl"></div>
                <div class="corner br"></div>

                <div class="cta-inner-content">
                    <p class="cta-note-premium text-accent italic">
                        Comencemos su proceso
                    </p>

                    <a href="#contacto" class="cta-gate-button">
                        <span>Iniciar evaluación clínica</span>
                        <div class="btn-aura"></div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .beneficios-wrapper {
        background-color: #03070d;
        padding: clamp(4rem, 8vw, 7rem) clamp(1rem, 5vw, 1.5rem);
    }

    .container {
        max-width: 1100px;
        margin: 0 auto;
    }

    /* HEADER */
    .beneficios-header {
        text-align: center;
        margin-bottom: clamp(2.5rem, 5vw, 4rem);
    }

    .title-beneficios {
        font-family: "Lora", serif;
        font-size: clamp(2rem, 4vw, 3rem);
        line-height: 1.15;
        max-width: 700px;
        margin: 0 auto;
        letter-spacing: -0.3px;
    }

    .beneficios-header span {
        display: block;
        margin-top: 0.6rem;
        font-size: clamp(0.9rem, 1.5vw, 1.1rem);
        opacity: 0.7;
    }

    hr {
        width: 50px;
        height: 1px;
        background: #c5a47e;
        border: none;
        margin: 1.2rem auto 0;
        opacity: 0.5;
    }

    /* GRID */
    .beneficios-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: clamp(1.5rem, 3vw, 2.5rem);
        max-width: 900px;
        margin: 0 auto;
    }

    /* CARD */
    .beneficio-card {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.06);
        padding: clamp(1.5rem, 3vw, 2.5rem);
        transition: all 0.35s ease;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .beneficio-card:hover {
        transform: translateY(-6px);
        background: rgba(255, 255, 255, 0.04);
        border-color: rgba(255, 255, 255, 0.12);
    }

    .beneficio-number {
        font-size: 0.75rem;
        letter-spacing: 0.3em;
        color: #c5a47e;
        margin-bottom: 1rem;
    }

    .beneficio-title {
        font-size: clamp(1.1rem, 2vw, 1.3rem);
        margin-bottom: 0.6rem;
        font-weight: 500;
    }

    .beneficio-description {
        font-size: 0.95rem;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.65);
    }

    /* CTA */
    .cta-exclusive-container {
        margin-top: clamp(3rem, 6vw, 5rem);
        display: flex;
        justify-content: center;
    }

    .exclusivity-frame {
        width: 100%;
        max-width: 520px;
        padding: clamp(2rem, 4vw, 2.8rem);
        text-align: center;
        border: 1px solid rgba(197, 164, 126, 0.2);
        position: relative;
    }

    .cta-note-premium {
        font-size: 0.75rem;
        letter-spacing: 2px;
        margin-bottom: 1rem;
        opacity: 0.7;
    }

    /* BOTÓN */
    .cta-gate-button {
        position: relative;
        z-index: 1;
        display: inline-block;
        width: 100%;
        max-width: 280px;
        padding: 1rem 1.4rem;

        color: #fff;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 0.75rem;
        font-weight: 600;

        border: 1px solid rgba(197, 164, 126, 0.6);
        overflow: hidden;

        transition: all 0.3s ease;
    }

    /* AURA */
    .btn-aura {
        position: absolute;
        inset: 0;
        background: #c5a47e;
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.5s ease;
        z-index: -1;
    }

    /* HOVER */
    .cta-gate-button:hover {
        color: #03070d;
        border-color: #c5a47e;
    }

    .cta-gate-button:hover .btn-aura {
        transform: scaleX(1);
    }

    /* MOBILE AUTO EFFECT */
    .cta-gate-button.active {
        color: #03070d;
        border-color: #c5a47e;
    }

    .cta-gate-button.active .btn-aura {
        transform: scaleX(1);
    }

    /* MOBILE */
    @media (max-width: 768px) {
        .beneficios-header {
            margin-bottom: 2rem;
        }

        .beneficio-card {
            padding: 1.4rem;
        }

        .beneficio-title {
            font-size: 1.15rem;
        }
    }
    @media (max-width: 768px) {
        .beneficios-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const button = document.querySelector(".cta-gate-button");

        if (!button) return;

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    // 🔥 Solo activo si está bien visible (no apenas entra)
                    if (entry.intersectionRatio > 0.6) {
                        button.classList.add("active");
                    } else {
                        button.classList.remove("active");
                    }
                });
            },
            {
                threshold: [0, 0.3, 0.6, 1],
            },
        );

        observer.observe(button);
    });
</script>
