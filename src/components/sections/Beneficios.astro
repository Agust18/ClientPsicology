---
import { BeneficiosData } from "../../data/Beneficios";
---

<section class="beneficios-wrapper">
    <div class="container">
        <div class="beneficios-header fade-in-up">
            <h2 class="title-display title-beneficios">
                {BeneficiosData.title}
            </h2>
            <span class="font-display italic text-accent"
                >Nuestros 4 pilares</span
            >
            <hr />
        </div>

        <div class="beneficios-grid">
            {
                BeneficiosData.items.map((item) => (
                    <div class="beneficio-card fade-in-up">
                        <div class="beneficio-content">
                            <span class="beneficio-number">0{item.id}</span>
                            <h3 class="beneficio-title">{item.title}</h3>
                            <p class="beneficio-description">
                                {item.description}
                            </p>
                        </div>
                        <div class="card-border-gradient" />
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .beneficios-wrapper {
        background-color: #03070d;
        padding: clamp(4rem, 8vw, 8rem) 1.5rem;
        position: relative;
        overflow: hidden;
    }

    .beneficios-header {
        margin-bottom: clamp(3rem, 5vw, 5rem);
        text-align: center;
    }

    /* Ajuste de especificidad para el subtítulo */
    .beneficios-header .font-display {
        display: block;
        font-size: clamp(1.2rem, 2vw, 1.6rem);
        margin-top: 0.5rem;
        letter-spacing: 0.05em;
    }
    hr {
        /* Línea más corta y elegante */
        width: 60px;
        border: none;
        height: 1px;
        background-color: var(--accent);
        margin: 1.5rem auto 2rem;
        opacity: 0.6;
    }
    span {
        font-size: clamp(1.5rem, 2vw, 1.8rem);
    }

    .title-beneficios {
        font-size: clamp(2.2rem, 4vw, 3.2rem);
        max-width: 800px;
        margin: 0 auto;
        line-height: 1.1;
        text-wrap: balance;
    }

    /* --- GRID DINÁMICO --- */
    .beneficios-grid {
        display: grid;
        /* El min(100%, 350px) previene el desborde en pantallas muy chicas */
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
        gap: clamp(1.5rem, 3vw, 2.5rem);
    }

    /* --- CARDS --- */
    .beneficio-card {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        padding: clamp(2rem, 4vw, 3.5rem);
        position: relative;
        transition: all 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .beneficio-card:hover {
        transform: translateY(-10px);
        background: rgba(255, 255, 255, 0.04);
        border-color: rgba(255, 255, 255, 0.15);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    }
    .beneficio-number {
        display: block;
        color: var(--accent);
        font-size: 0.85rem;
        font-weight: 700;
        margin-bottom: 2rem;
        letter-spacing: 0.4em;
        opacity: 0.8;
    }

    .beneficio-title {
        font-size: 1.5rem;
        margin-bottom: 1.2rem;
        color: #fff;
        font-weight: 500;
    }

    .beneficio-description {
        color: rgba(226, 232, 240, 0.65);
        line-height: 1.8;
        font-size: 1rem;
        text-wrap: pretty;
    }

    /* --- LÍNEA DE HOVER --- */
    .card-border-gradient {
        position: absolute;
        bottom: 0;
        left: 50%;
        width: 0%;
        height: 2px;
        background: var(--accent);
        transform: translateX(-50%);
        transition: width 0.6s ease;
    }

    .beneficio-card:hover .card-border-gradient {
        width: 100%;
    }

    /* --- RESPONSIVE DESKTOP --- */
    @media (min-width: 1200px) {
        .beneficios-grid {
            /* Forzamos 2 columnas limpias en desktop para mantener el orden */
            grid-template-columns: repeat(2, 1fr);
            max-width: 1100px;
            margin: 0 auto;
        }
    }

    /* --- AJUSTES MÓVIL --- */
    @media (max-width: 768px) {
        .beneficio-card {
            text-align: center;
        }

        .beneficio-number {
            margin-bottom: 1rem;
        }
    }

    /* PANTALLAS MINI */
    @media (max-width: 360px) {
        .title-beneficios {
            font-size: 1.8rem;
        }
        .beneficios-wrapper {
            padding-inline: 1rem;
        }
    }
</style>
