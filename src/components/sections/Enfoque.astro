---
import { EnfoqueData } from "../../data/Enfoque";
---

<section class="enfoque-split" id="enfoque-section">
    <div class="container">
        <div class="split-layout">
            <!-- LADO IZQUIERDO: Fijo al scrollear (Desktop) -->
            <div class="left-col">
                <div class="sticky-info">
                    <span class="tag gsap-fade"
                        >{EnfoqueData.header.eyebrow}</span
                    >
                    <h2 class="title gsap-fade">{EnfoqueData.header.title}</h2>
                    <div class="scroll-indicator gsap-fade">
                        <div class="line"></div>
                        <span class="italic text-accent">EXPLORAR</span>
                    </div>
                </div>
            </div>

            <!-- LADO DERECHO: Contenido que fluye -->
            <div class="right-col">
                <div class="content-card gsap-card">
                    <span class="card-num italic">01</span>
                    <h3>El Equipo</h3>
                    <p class="text-lead">{EnfoqueData.contenido.principal}</p>
                </div>

                <div class="content-card gsap-card">
                    <span class="card-num italic">02</span>
                    <h3>El Modelo</h3>
                    <p class="text-lead">{EnfoqueData.contenido.modelo}</p>
                </div>

                <div class="content-card gsap-card">
                    <span class="card-num italic">03</span>
                    <h3>Metodología</h3>
                    <p>{EnfoqueData.contenido.metodologia}</p>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    // Animación para las tarjetas de la derecha
    gsap.utils.toArray(".gsap-card").forEach((card: any) => {
        gsap.from(card, {
            opacity: 0,
            x: 50,
            duration: 1,
            scrollTrigger: {
                trigger: card,
                start: "top 85%",
                toggleActions: "play none none reverse",
            },
        });
    });

    // Animación del encabezado izquierdo
    gsap.from(".gsap-fade", {
        opacity: 0,
        y: 30,
        stagger: 0.2,
        duration: 1,
        scrollTrigger: {
            trigger: "#enfoque-section",
            start: "top 70%",
        },
    });
</script>

<style>
    .enfoque-split {
        background-color: #03070d;
        color: #fff;
        padding: clamp(4rem, 10vw, 8rem) 1.5rem;
        min-height: 100vh;
    }

    .container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .split-layout {
        display: grid;
        grid-template-columns: 1fr;
        gap: 4rem;
    }

    @media (min-width: 1024px) {
        .split-layout {
            grid-template-columns: 1fr 1fr;
            gap: 10%;
        }

        .sticky-info {
            position: sticky;
            top: 15vh;
        }
    }

    /* Estilos Izquierda */
    .tag {
        color: #c5a47e;
        font-size: 0.75rem;
        letter-spacing: 0.3em;
        font-weight: 700;
        margin-bottom: 2rem;
        display: block;
    }

    .title {
        font-family: "Lora", serif;
        font-size: clamp(2.2rem, 4vw, 3.5rem);
        line-height: 1.1;
        font-weight: 400;
    }

    .scroll-indicator {
        margin-top: 4rem;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        color: rgba(255, 255, 255, 0.4);
        font-size: 0.7rem;
        letter-spacing: 0.2em;
    }

    .scroll-indicator .line {
        width: 60px;
        height: 1px;
        background-color: rgba(197, 164, 126, 0.4);
    }

    /* Estilos Derecha */
    .content-card {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        padding: clamp(2rem, 5vw, 4rem);
        margin-bottom: 2rem;
        border-radius: 4px;
        transition: border-color 0.4s ease;
    }

    .content-card:hover {
        border-color: rgba(197, 164, 126, 0.3);
    }

    .card-num {
        font-family: "Lora", serif;
        color: #c5a47e;
        font-size: 1.2rem;
        display: block;
        margin-bottom: 2rem;
        opacity: 0.6;
    }

    .content-card h3 {
        font-family: "Lora", serif;
        font-size: 2rem;
        margin-bottom: 1.5rem;
        font-weight: 400;
    }

    .content-card p {
        color: rgba(255, 255, 255, 0.7);
        line-height: 1.8;
        font-size: 1.1rem;
    }

    @media (max-width: 1024px) {
        .content-card {
            padding: 2rem;
        }
    }
</style>
