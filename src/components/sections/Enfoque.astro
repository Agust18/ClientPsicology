---
import { EnfoqueData } from "../../data/Enfoque";
---

<section class="enfoque-wrapper">
    <div class="container">
        <!-- Encabezado con jerarquía visual -->
        <div class="enfoque-header">
            <h2 class="title-display enfoque-title fade-in">
                {EnfoqueData.title}
            </h2>
            <h3 class="text-accent enfoque-subtitle fade-in">
                {EnfoqueData.highlight}
            </h3>
        </div>

        <!-- Contenedor Principal (The Glass Box) -->
        <div class="enfoque-card">
            <!-- Introducción con tipografía Lora -->
            <div class="intro-container">
                {
                    EnfoqueData.intro1.map((paragraph) => (
                        <p class="text-lead intro1 fade-in">{paragraph}</p>
                    ))
                }
                {
                    EnfoqueData.intro.map((paragraph) => (
                        <p class="text-lead fade-in">{paragraph}</p>
                    ))
                }
            </div>

            <!-- Principios / Ejes -->
            <div class="principles-grid">
                {
                    EnfoqueData.principles.map((item) => (
                        <div class="principle-item fade-in">
                            <div class="principle-dot" />
                            <p class="text-lead">{item}</p>
                        </div>
                    ))
                }
            </div>

            <!-- Sección Equipo e Interdisciplina -->
            <div class="disciplines-section fade-in">
                <p class="text-lead">
                    {EnfoqueData.teamIntro}
                </p>

                <div class="disciplines-container">
                    {
                        EnfoqueData.disciplines.map((discipline) => (
                            <span class="discipline-badge">{discipline}</span>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .enfoque-wrapper {
        background-color: #03070d;
        padding: 8rem 1.5rem;
        color: white;
        overflow: hidden;
    }

    .enfoque-header {
        margin-bottom: 4rem;
        text-align: center;
    }

    .enfoque-title {
        font-size: clamp(2rem, 5vw, 3.5rem);
        line-height: 1.1;
        margin-bottom: 1rem;
    }

    .intro1 {
        color: var(--accent);
        font-weight: 600;
        font-size: clamp(1.2rem, 1.5vw + 0.9rem, 1.5rem);
        text-align: center; /* La intro queda mejor centrada */
    }

    /* --- LA CARD (GLASS) --- */
    .enfoque-card {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        padding: 4rem;
        max-width: 1000px;
        margin: 0 auto;
    }

    /* --- GRID DE PRINCIPIOS --- */
    .principles-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2.5rem;
        margin: 4rem 0;
    }

    .principle-item {
        display: flex;
        gap: 1.2rem;
    }
    .principle-dot {
        width: 8px;
        height: 8px;
        background-color: var(--accent);
        border-radius: 50%;
        margin-top: 0.6rem;
        flex-shrink: 0;
        box-shadow: 0 0 10px var(--accent);
    }

    /* --- DISCIPLINAS --- */
    .disciplines-section {
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        padding-top: 3rem;
        margin-top: 2rem;
    }

    .disciplines-container {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
        margin-top: 2rem;
    }

    .discipline-badge {
        padding: 0.5rem 1rem;
        font-size: 0.7rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #e2e8f0;
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .discipline-badge:hover {
        border-color: var(--accent);
        color: var(--accent);
        background: rgba(180, 147, 90, 0.05);
    }

    /* --- RESPONSIVE --- */

    @media (max-width: 768px) {
        .enfoque-wrapper {
            padding: 5rem 1rem;
        }

        .enfoque-card {
            padding: 2.5rem 1.5rem;
        }

        .principles-grid {
            grid-template-columns: 1fr; /* Una columna sola para que el texto no se aprete */
            gap: 1.5rem;
        }

        .text-lead {
            text-align: left; /* En móvil pequeño, a veces el justify deja huecos feos */
        }

        .disciplines-section {
            margin-top: 2rem;
        }

        .disciplines-container {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            justify-content: space-between;
        }

        .team-intro {
            text-align: center;
        }
    }

    @media (min-width: 1200px) {
        .enfoque-header {
            text-align:;
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const animateEnfoque = () => {
        // Animación de aparición escalonada para todos los elementos con .fade-in
        gsap.from(".fade-in", {
            scrollTrigger: {
                trigger: ".enfoque-wrapper",
                start: "top 80%",
                toggleActions: "play none none none",
            },
            y: 30,
            opacity: 0,
            duration: 1,
            stagger: 0.2,
            ease: "power3.out",
        });
    };

    animateEnfoque();
    document.addEventListener("astro:after-swap", animateEnfoque);
</script>
