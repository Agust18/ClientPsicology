  <nav id="main-nav" class="nav">
    <div class="nav-container">
      <div class="logo-container">
        <a href="#inicio" class="logo">Psicología <span>Boutique</span></a>
      </div>

      <div class="nav-links">
        <a href="#inicio" class="nav-link">Inicio</a>
        <a href="#sobre-nosotros" class="nav-link">Nosotros</a>
        <a href="#areas-intervencion" class="nav-link">Servicios</a>
        <a href="#filosofia" class="nav-link">Filosofía</a>
        <a href="#contacto" class="cta nav-link">Solicitar Consulta</a>
      </div>

      <button id="menu-btn" class="menu-btn">
        <span></span><span></span><span></span>
      </button>
    </div>

    <div id="mobile-menu" class="mobile-menu">
      <a href="#inicio" class="mobile-link">Inicio</a>
      <a href="#sobre-nosotros" class="mobile-link">Nosotros</a>
      <a href="#areas-intervencion" class="mobile-link">Servicios</a>
      <a href="#filosofia" class="mobile-link">Filosofía</a>
      <div class="mobile-cta-container">
        <a href="#contacto" class="cta">Solicitar Consulta</a>
      </div>
    </div>
  </nav>
</section>
<style>
  .nav-section {
    padding-bottom: 20px;
  }

  .nav {
    position: fixed;
    top: 0;
    width: 100%;
    height: 80px;
    z-index: 1000;
    background: rgba(10, 10, 10, 0.35);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    transition: all 0.35s ease;
  }

  .nav-container {
    max-width: 1200px;
    margin: auto;
    height: 100%;
    padding: 0 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  /* LOGO */
  .logo {
    color: white;
    text-decoration: none;
    font-family: "Lora", serif;
  }

  .logo span {
    color: var(--accent);
    font-style: italic;
  }

  /* LINKS DESKTOP */
  .nav-links {
    display: none;
  }

  @media (min-width: 768px) {
    .nav-links {
      display: flex;
      gap: 10px;
      align-items: center;
      margin: 0 60px;
    }

    .menu-btn {
      display: none;
    }
  }

  .nav-link {
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    transition: 0.3s;
  }

  .nav-link:hover {
    color: white;
  }

  .nav-link.active {
    color: white;
  }

  /* CTA */
  .cta {
    background: var(--accent);
    color: #0a1a2f;
    padding: 10px 18px;
    border-radius: 6px;
    font-weight: 700;
  }

  /* MOBILE */
  .mobile-menu {
    position: fixed;
    inset: 0;
    background: var(--primary);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    padding-top: 110px;
    gap: 20px;
    transform: translateX(100%);
    transition: 0.35s ease;
    z-index: 999;
    padding-bottom: 20px;
  }

  .mobile-menu.active {
    transform: translateX(0);
  }

  .mobile-link {
    color: white;
    text-decoration: none;
    font-size: 1.2rem;
  }

  /* BURGER */
  .menu-btn {
    width: 26px;
    height: 20px;
    position: relative;
    background: none;
    border: none;
  }

  .menu-btn span {
    position: absolute;
    width: 100%;
    height: 2px;
    background: white;
    transition: 0.3s;
  }

  .menu-btn span:nth-child(1) {
    top: 0;
  }
  .menu-btn span:nth-child(2) {
    top: 50%;
    transform: translateY(-50%);
  }
  .menu-btn span:nth-child(3) {
    bottom: 0;
  }

  .menu-btn.open span:nth-child(1) {
    top: 50%;
    transform: rotate(45deg);
  }
  .menu-btn.open span:nth-child(2) {
    opacity: 0;
  }
  .menu-btn.open span:nth-child(3) {
    top: 50%;
    transform: rotate(-45deg);
  }

  .mobile-menu.active {
    height: 100vh;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0 0 10px 10px;
  }

  .body-lock {
    overflow: hidden;
  }
</style>

<script is:inline>
  const nav = document.getElementById("main-nav");
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");
  const links = document.querySelectorAll(".nav-link");

  let sections = [];

  /* =========================
   INIT SECCIONES
========================= */
  function init() {
    sections = Array.from(document.querySelectorAll("section[id]"));
  }

  /* =========================
   MOBILE MENU
========================= */
  if (btn && menu) {
    btn.addEventListener("click", () => {
      const open = menu.classList.toggle("active");
      btn.classList.toggle("open", open);
      document.body.classList.toggle("body-lock", open);
    });
  }

  /* =========================
   SCROLL HANDLER
========================= */
  function onScroll() {
    const y = window.scrollY;

    if (nav) {
      nav.classList.toggle("shrink", y > 50);
    }

    let current = "";

    for (let i = 0; i < sections.length; i++) {
      const section = sections[i];
      const rect = section.getBoundingClientRect();

      if (rect.top <= 120 && rect.bottom > 120) {
        current = section.id;
        break;
      }
    }

    links.forEach((link) => {
      const href = link.getAttribute("href");
      const isActive = current && href === "#" + current;
      link.classList.toggle("active", isActive);
    });
  }

  /* =========================
   RAF THROTTLE
========================= */
  let ticking = false;

  window.addEventListener("scroll", () => {
    if (!ticking) {
      window.requestAnimationFrame(() => {
        onScroll();
        ticking = false;
      });
      ticking = true;
    }
  });

  /* =========================
   INIT SEGURO
========================= */
  function setup() {
    init();
    onScroll();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setup);
  } else {
    setup();
  }
</script>
