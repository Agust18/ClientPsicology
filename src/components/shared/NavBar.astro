<!-- ============================================================
     STYLES
     ============================================================ -->
<style>
  /* ---------- Tokens ---------- */
  :root {
    --nav-h: 70px;
    --accent: #b4935a;
    --primary: #0a1a2f;
    --glass-bg: rgba(8, 18, 38, 0);
    --glass-border: rgba(255, 255, 255, 0.5);
    --link-idle: rgba(255, 255, 255, 0.82);
    --link-hover: #ffffff;
    --link-active: #ffffff;
    --ease: cubic-bezier(0.4, 0, 0.2, 1);
    --drawer-w: min(360px, 90vw);
  }

  /* ---------- Navbar shell ---------- */
  .nav {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 900;
    height: var(--nav-h);
    background: var(--glass-bg);
    backdrop-filter: blur(50px);
    -webkit-backdrop-filter: blur(50px);
    border-bottom: 0.5px solid var(--glass-border);
    transition:
      background 0.35s var(--ease),
      box-shadow 0.35s var(--ease),
      height 0.35s var(--ease);
  }

  .nav.scrolled {
    background: rgba(8, 18, 38, 0.1);
    box-shadow: 0 4px 32px rgba(0, 0, 0, 0.5);
    height: 62px;
  }

  /* ---------- Inner container ---------- */
  .nav-inner {
    max-width: 1200px;
    height: 100%;
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 40px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  /* ---------- Logo ---------- */
  .nav-logo {
    font-family: "Lora", Georgia, serif;
    font-size: 1.15rem;
    font-weight: 300;
    color: #ffffff;
    text-decoration: none;
    letter-spacing: 0.01em;
    white-space: nowrap;
    flex-shrink: 0;
    transition: opacity 0.2s;
  }
  .nav-logo:hover {
    opacity: 0.85;
  }
  .nav-logo em {
    color: var(--accent);
    font-style: italic;
    font-weight: 300;
  }

  /* ---------- Desktop links ---------- */
  .nav-links {
    display: none; /* hidden < 768 */
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
    gap: 4px;
  }

  @media (min-width: 768px) {
    .nav-links {
      display: flex;
    }
  }

  .nav-link {
    position: relative;
    display: inline-block;
    padding: 6px 12px;
    color: var(--link-idle);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    letter-spacing: 0.025em;
    border-radius: 6px;
    transition:
      color 0.22s,
      background 0.22s;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    inset-inline: 12px;
    bottom: 2px;
    height: 2px;
    background: var(--accent);
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }

  .nav-link:hover {
    color: var(--link-hover);
    background: rgba(255, 255, 255, 0.07);
  }

  .nav-link.active {
    color: var(--link-active);
  }
  .nav-link.active::after {
    transform: scaleX(1);
  }

  /* CTA pill desktop */
  .nav-cta-desktop {
    display: inline-block;
    margin-left: 8px;
    padding: 8px 18px;
    background: var(--accent);
    color: #0a1a2f;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: 8px;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition:
      background 0.22s,
      transform 0.15s,
      box-shadow 0.22s;
    box-shadow: 0 2px 12px rgba(180, 147, 90, 0.35);
  }
  .nav-cta-desktop:hover {
    background: #c9a96e;
    transform: translateY(-1px);
    box-shadow: 0 6px 12px rgba(180, 147, 90, 0.1);
  }

  /* ---------- Hamburger button ---------- */
  .nav-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    padding: 7px 5px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.2s;
  }
  .nav-toggle:hover {
    background: rgba(255, 255, 255, 0.14);
  }

  @media (min-width: 768px) {
    .nav-toggle {
      display: none;
    }
  }

  .bar {
    display: block;
    height: 2px;
    background: #ffffff;
    border-radius: 2px;
    transition:
      transform 0.3s var(--ease),
      opacity 0.2s,
      width 0.3s var(--ease);
  }
  .bar-1 {
    width: 20px;
  }
  .bar-2 {
    width: 14px;
    align-self: flex-end;
  }
  .bar-3 {
    width: 20px;
  }

  /* Hamburger → X (handled via JS adding .open to button) */
  .nav-toggle.open .bar-1 {
    transform: translateY(7px) rotate(45deg);
    width: 20px;
  }
  .nav-toggle.open .bar-2 {
    opacity: 0;
    transform: scaleX(0);
  }
  .nav-toggle.open .bar-3 {
    transform: translateY(-7px) rotate(-45deg);
    width: 20px;
    align-self: flex-start;
  }

  /* ---------- Backdrop ---------- */
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: 910;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(2px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s var(--ease);
  }
  .backdrop.visible {
    opacity: 1;
    pointer-events: all;
  }

  /* ---------- Mobile drawer ---------- */
  .drawer {
    position: fixed;
    inset-block: 0;
    inset-inline-end: 0;
    z-index: 920;
    width: var(--drawer-w);
    background: linear-gradient(160deg, #0d1f3c 0%, #071121 100%);
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0;
    padding: 48px 32px 40px;
    transform: translateX(100%);
    transition: transform 0.38s var(--ease);
    will-change: transform;
  }
  .drawer.open {
    transform: translateX(0);
  }

  /* X button inside drawer */
  .drawer-close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 50%;
    cursor: pointer;
    transition:
      color 0.2s,
      background 0.2s,
      transform 0.2s;
  }
  .drawer-close:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.14);
    transform: rotate(90deg);
  }

  /* Logo inside drawer */
  .drawer-logo {
    font-family: "Lora", Georgia, serif;
    font-size: 1.25rem;
    font-weight: 300;
    color: #fff;
    margin-bottom: 36px;
    letter-spacing: 0.01em;
  }
  .drawer-logo em {
    color: var(--accent);
    font-style: italic;
    font-weight: 300;
  }

  /* Drawer nav list */
  .drawer-links {
    list-style: none;
    margin: 0 0 32px;
    padding: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .drawer-link {
    display: block;
    padding: 14px 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: 1.2rem;
    font-weight: 500;
    text-decoration: none;
    text-align: center;
    letter-spacing: 0.02em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    transition:
      color 0.2s,
      letter-spacing 0.2s;
  }
  .drawer-link:last-child {
    border-bottom: none;
  }
  .drawer-link:hover {
    color: #fff;
    letter-spacing: 0.06em;
  }

  /* CTA inside drawer */
  .drawer-cta-mobile {
    display: inline-block;
    margin-top: 8px;
    padding: 14px 32px;
    background: var(--accent);
    color: #0a1a2f;
    font-size: 0.95rem;
    font-weight: 700;
    border-radius: 10px;
    text-decoration: none;
    letter-spacing: 0.03em;
    box-shadow: 0 4px 20px rgba(180, 147, 90, 0.45);
    transition:
      background 0.22s,
      transform 0.15s,
      box-shadow 0.22s;
  }
</style>

<script>
  const nav = document.getElementById("main-nav") as HTMLElement | null;
  const toggle = document.getElementById(
    "nav-toggle",
  ) as HTMLButtonElement | null;
  const drawer = document.getElementById("mobile-drawer") as HTMLElement | null;
  const backdrop = document.getElementById(
    "drawer-backdrop",
  ) as HTMLElement | null;
  const closeBtn = document.getElementById(
    "drawer-close",
  ) as HTMLButtonElement | null;
  const navLinks = document.querySelectorAll<HTMLAnchorElement>(".nav-link");
  const drawerLinks = document.querySelectorAll<HTMLAnchorElement>(
    ".drawer-link, .drawer-cta",
  );

  let sections: Element[] = [];
  let ticking = false;

  /* ---- Init ---- */
  const init = (): void => {
    sections = Array.from(document.querySelectorAll("section[id]"));
  };

  /* ---- Open / close drawer ---- */
  const openDrawer = (): void => {
    drawer?.classList.add("open");
    backdrop?.classList.add("visible");
    toggle?.classList.add("open");
    toggle?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  };

  const closeDrawer = (): void => {
    drawer?.classList.remove("open");
    backdrop?.classList.remove("visible");
    toggle?.classList.remove("open");
    toggle?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  };

  toggle?.addEventListener("click", () => {
    const isOpen = drawer?.classList.contains("open");
    isOpen ? closeDrawer() : openDrawer();
  });

  closeBtn?.addEventListener("click", closeDrawer);
  backdrop?.addEventListener("click", closeDrawer);
  drawerLinks.forEach((l) => l.addEventListener("click", closeDrawer));

  /* Escape key */
  document.addEventListener("keydown", (e: KeyboardEvent) => {
    if (e.key === "Escape") closeDrawer();
  });

  /* ---- Scroll handler ---- */
  const onScroll = (): void => {
    const y = window.scrollY;
    const trigger = 100;

    nav?.classList.toggle("scrolled", y > 50);

    let current: string | null = null;
    for (const section of sections) {
      const rect: DOMRect = section.getBoundingClientRect();
      if (rect.top <= trigger && rect.bottom > trigger) {
        current = section.id;
        break;
      }
    }

    navLinks.forEach((link: HTMLAnchorElement) => {
      const href: string | null = link.getAttribute("href");
      link.classList.toggle(
        "active",
        Boolean(current && href === `#${current}`),
      );
    });
  };

  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          onScroll();
          ticking = false;
        });
        ticking = true;
      }
    },
    { passive: true },
  );

  /* ---- Boot ---- */
  const setup = (): void => {
    init();
    onScroll();
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setup, { once: true });
  } else {
    setup();
  }

  document.addEventListener("astro:page-load", setup);
</script>
