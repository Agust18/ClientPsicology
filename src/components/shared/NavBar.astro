  <div class="nav-container">
    
    <a href="#inicio" class="logo">
      Psicología <span>Boutique</span>
    </a>

    <div class="nav-links">
      <a href="#inicio">Inicio</a>
      <a href="#sobre-nosotros">Nosotros</a>
      <a href="#areas-intervencion">Servicios</a>
      <a href="#filosofia">Filosofía</a>
      <a href="#contacto" class="cta hoveclass">Solicitar Consulta</a>
    </div>

    <button id="menu-btn" class="menu-btn">
      <span></span>
      <span></span>
      <span></span>
    </button>

  </div>

  <div id="mobile-menu" class="mobile-menu">
    <a href="#inicio">Inicio</a>
    <a href="#sobre-nosotros">Nosotros</a>
    <a href="#areas-intervencion">Servicios</a>
    <a href="#filosofia">Filosofía</a>
    <a href="#contacto" class="cta">Solicitar Consulta</a>
  </div>
</nav>

<style>
body {
  padding-top: 40px;
}

/* NAV */
.nav {
  position: fixed;
  top: 0;
  width: 100%;
  height: 80px;
  display: flex;
  align-items: center;
  z-index: 1000;
  background: rgba(10, 10, 10, 0.6);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid rgba(255,255,255,0.1);
  transition: transform 0.3s ease;
}



/* CONTAINER */
.nav-container {
  width: 100%;
  max-width: 1200px;
  margin: auto;
  padding: 0 20px;

  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* LOGO */
.logo {
  font-family: 'Lora', serif;
  color: white;
  text-decoration: none;
  flex-shrink: 0;
}

.logo span {
  font-style: italic;
  color: var(--accent);
}

/* DESKTOP LINKS */
.nav-links {
  display: none;
}

@media (min-width: 768px) {
  .nav-links {
    display: flex;
    gap: 25px;
    align-items: center;
  }
}

/* LINKS */
.nav-links a {
  color: rgba(255,255,255,0.9);
  text-decoration: none;
}

.nav-links a:hover {
  color: var(--accent);
}

/* CTA */
.cta {
  background: var(--accent);
  color: var(--primary);
  padding: 10px 20px;
  border-radius: 4px;
  font-weight: bold;
}

/* BOTÓN MOBILE */
.menu-btn {
  position: relative;
  width: 25px;
  height: 20px;
  background: none;
  border: none;
  z-index: 1200;
}

@media (min-width: 768px) {
  .menu-btn {
    display: none;
  }
}

/* líneas */
.menu-btn span {
  position: absolute;
  left: 0;
  width: 100%;
  height: 3px;
  background: white;
  transition: 0.3s;
}

.menu-btn span:nth-child(1) {
  top: 0;
}

.menu-btn span:nth-child(2) {
  top: 50%;
  transform: translateY(-50%);
}

.menu-btn span:nth-child(3) {
  bottom: 0;
}

/* cruz */
.menu-btn.open span:nth-child(1) {
  top: 50%;
  transform: translateY(-50%) rotate(45deg);
}

.menu-btn.open span:nth-child(2) {
  opacity: 0;
}

.menu-btn.open span:nth-child(3) {
  top: 50%;
  transform: translateY(-50%) rotate(-45deg);
}

/* MOBILE MENU */
.mobile-menu {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100vh; /* 🔥 clave */
  overflow-y: auto; /* 🔥 permite scroll si no entra */
  background: var(--primary);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 30px;
  transform: translateX(100%);
  transition: transform 0.4s ease;
  z-index: 1100;
}

.mobile-menu.active {
  transform: translateX(0);
}

/* ocultar en desktop */
@media (min-width: 768px) {
  .mobile-menu {
    display: none;
  }
}

/* LINKS MOBILE */
.mobile-menu a {
  color: white;
  font-size: 1.3rem;
  text-decoration: none;
  font-family: 'Lora', serif;
  transition: 0.3s;
}

.mobile-menu a:hover {
  color: var(--accent);
  transform: scale(1.05);
}

/* BODY LOCK */
.body-lock {
  overflow: hidden;
}

.hoveclass:hover{
  background-color: white;
  
  
}
</style>

<script>
// @ts-nocheck

document.addEventListener("DOMContentLoaded", () => {

  const nav = document.getElementById("main-nav");
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");

  if (!nav || !btn || !menu) return;

  let lastScroll = 0;

  // SCROLL NAV
  window.addEventListener("scroll", () => {
    const currentScroll = window.scrollY;

    if (menu.classList.contains("active")) return;
    if (Math.abs(currentScroll - lastScroll) < 10) return;

    if (currentScroll > lastScroll && currentScroll > 100) {
      nav.style.transform = "translateY(-100%)";
    } else {
      nav.style.transform = "translateY(0)";
    }

    lastScroll = currentScroll;
  });

  // TOGGLE MENU
  btn.addEventListener("click", () => {
    const isOpen = menu.classList.toggle("active");

    btn.classList.toggle("open", isOpen);
    document.body.classList.toggle("body-lock", isOpen);

    if (isOpen) {
      nav.style.transform = "translateY(0)";
    }
  });

});
</script>