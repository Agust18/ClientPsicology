---
const anioActual = new Date().getFullYear();
---

<footer class="pie-pagina" aria-labelledby="titulo-pie-pagina">
    <!-- Título oculto accesible para lectores de pantalla -->
    <h2 id="titulo-pie-pagina" class="sr-only">Pie de página</h2>

    <div class="pie-pagina__contenedor">
        <!--  
         FILA SUPERIOR: marca + columnas de navegación
          -->
        <div class="pie-pagina__grilla">
            <!-- Columna 1: Identidad de marca -->
            <div class="pie-pagina__marca">
                <p class="pie-pagina__logo" aria-label="Psicología Boutique">
                    Psicología <em>Boutique</em>
                </p>
                <p class="pie-pagina__descripcion">
                    Acompañamiento psicológico especializado, centrado en la
                    persona, con un abordaje humano, integrador y de alta
                    calidad clínica.
                </p>

                <!-- Redes sociales (a11y: aria-label descriptivo) -->
                <ul
                    class="pie-pagina__redes"
                    role="list"
                    aria-label="Redes sociales"
                >
                    <li>
                        <a
                            href="https://instagram.com"
                            class="pie-pagina__enlace-red"
                            aria-label="Seguinos en Instagram"
                            rel="noopener noreferrer"
                            target="_blank"
                        >
                            <svg
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                aria-hidden="true"
                                focusable="false"
                            >
                                <rect
                                    x="2"
                                    y="2"
                                    width="20"
                                    height="20"
                                    rx="5"
                                    ry="5"
                                    stroke="currentColor"
                                    stroke-width="2"></rect>
                                <circle
                                    cx="12"
                                    cy="12"
                                    r="4"
                                    stroke="currentColor"
                                    stroke-width="2"></circle>
                                <circle
                                    cx="17.5"
                                    cy="6.5"
                                    r="1"
                                    fill="currentColor"></circle>
                            </svg>
                            <span class="sr-only">Instagram</span>
                        </a>
                    </li>
                    <li>
                        <a
                            href="https://linkedin.com"
                            class="pie-pagina__enlace-red"
                            aria-label="Visitanos en LinkedIn"
                            rel="noopener noreferrer"
                            target="_blank"
                        >
                            <svg
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                aria-hidden="true"
                                focusable="false"
                            >
                                <rect
                                    x="2"
                                    y="2"
                                    width="20"
                                    height="20"
                                    rx="3"
                                    stroke="currentColor"
                                    stroke-width="2"></rect>
                                <path
                                    d="M7 10v7M7 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"></path>
                            </svg>
                            <span class="sr-only">LinkedIn</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Columna 2: Navegación principal -->
            <nav
                class="pie-pagina__columna"
                aria-label="Navegación del pie de página"
            >
                <h3 class="pie-pagina__titulo-columna">Navegación</h3>
                <ul class="pie-pagina__lista" role="list">
                    <li>
                        <a href="#inicio" class="pie-pagina__enlace">Inicio</a>
                    </li>
                    <li>
                        <a href="#sobre-nosotros" class="pie-pagina__enlace"
                            >Nosotros</a
                        >
                    </li>
                    <li>
                        <a href="#areas-intervencion" class="pie-pagina__enlace"
                            >Servicios</a
                        >
                    </li>
                    <li>
                        <a href="#filosofia" class="pie-pagina__enlace"
                            >Filosofía</a
                        >
                    </li>
                    <li>
                        <a href="#contacto" class="pie-pagina__enlace"
                            >Contacto</a
                        >
                    </li>
                </ul>
            </nav>

            <!-- Columna 3: Servicios -->
            <nav class="pie-pagina__columna" aria-label="Servicios ofrecidos">
                <h3 class="pie-pagina__titulo-columna">Servicios</h3>
                <ul class="pie-pagina__lista" role="list">
                    <li>
                        <a href="#areas-intervencion" class="pie-pagina__enlace"
                            >Áreas de Intervención</a
                        >
                    </li>
                    <li>
                        <a
                            href="#psicologia-organizacional"
                            class="pie-pagina__enlace"
                            >Psicología Organizacional</a
                        >
                    </li>
                    <li>
                        <a
                            href="#contacto"
                            class="pie-pagina__enlace pie-pagina__enlace--destacado"
                            >Solicitar Consulta</a
                        >
                    </li>
                </ul>
            </nav>

            <!-- Columna 4: Legal -->
            <nav class="pie-pagina__columna" aria-label="Información legal">
                <h3 class="pie-pagina__titulo-columna">Legal</h3>
                <ul class="pie-pagina__lista" role="list">
                    <li>
                        <a href="/privacidad" class="pie-pagina__enlace"
                            >Política de Privacidad</a
                        >
                    </li>
                    <li>
                        <a href="/terminos" class="pie-pagina__enlace"
                            >Términos de Servicio</a
                        >
                    </li>
                </ul>
            </nav>
        </div>

        <!-- 
         FILA INFERIOR: copyright + créditos
          -->
        <div class="pie-pagina__inferior" role="contentinfo">
            <p class="pie-pagina__copyright">
                &copy; {anioActual} Psicología Boutique. Todos los derechos reservados.
            </p>
            <p class="pie-pagina__credenciales">
                Credenciales verificadas &middot; Atención ética y responsable
            </p>
        </div>
    </div>
</footer>

<style>
    /* 
     TOKENS locales (heredan de :root del proyecto)
      */
    .pie-pagina {
        --pie-fondo: #05101f;
        --pie-borde: rgba(255, 255, 255, 0.08);
        --pie-texto: rgba(255, 255, 255, 0.55);
        --pie-texto-hover: #ffffff;
        --pie-acento: #b4935a;
        --pie-titulo: rgba(255, 255, 255, 0.9);
        --pie-espacio: clamp(40px, 6vw, 80px);
        --pie-radio: 6px;
        --transicion: 0.22s ease;
    }

    /* ============================================================
     SHELL
     ============================================================ */
    .pie-pagina {
        background-color: var(--pie-fondo);
        border-top: 1px solid var(--pie-borde);
        padding-block: var(--pie-espacio);
        width: 100%;
    }

    .pie-pagina__contenedor {
        max-width: 1200px;
        margin-inline: auto;
        padding-inline: clamp(16px, 4vw, 40px);
    }

    /* ============================================================
     GRILLA DE 4 COLUMNAS
     ============================================================ */
    .pie-pagina__grilla {
        display: grid;
        grid-template-columns: 1fr;
        gap: 40px 32px;
    }

    @media (min-width: 576px) {
        .pie-pagina__grilla {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (min-width: 900px) {
        .pie-pagina__grilla {
            grid-template-columns: 2fr 1fr 1fr 1fr;
        }
    }

    /* ============================================================
     COLUMNA DE MARCA
     ============================================================ */
    .pie-pagina__logo {
        font-family: "Lora", Georgia, serif;
        font-size: 1.1rem;
        font-weight: 400;
        color: #ffffff;
        margin: 0 0 12px;
        letter-spacing: 0.01em;
    }

    .pie-pagina__logo em {
        color: var(--pie-acento);
        font-style: italic;
    }

    .pie-pagina__descripcion {
        font-family: "Inter", sans-serif;
        font-size: 0.85rem;
        line-height: 1.75;
        color: var(--pie-texto);
        margin: 0 0 24px;
        max-width: 28ch;
    }

    /* ============================================================
     REDES SOCIALES
     ============================================================ */
    .pie-pagina__redes {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        gap: 10px;
    }

    .pie-pagina__enlace-red {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        color: var(--pie-texto);
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid var(--pie-borde);
        text-decoration: none;
        transition:
            color var(--transicion),
            background var(--transicion),
            border-color var(--transicion),
            transform var(--transicion);
    }

    .pie-pagina__enlace-red:hover,
    .pie-pagina__enlace-red:focus-visible {
        color: var(--pie-acento);
        background: rgba(180, 147, 90, 0.1);
        border-color: rgba(180, 147, 90, 0.35);
        transform: translateY(-2px);
        outline: none;
    }

    /* ============================================================
     COLUMNAS DE NAVEGACIÓN
     ============================================================ */
    .pie-pagina__columna {
        display: flex;
        flex-direction: column;
    }

    .pie-pagina__titulo-columna {
        font-family: "Lora", Georgia, serif;
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--pie-titulo);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        margin: 0 0 18px;
    }

    .pie-pagina__lista {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    /* ============================================================
     ENLACES
     ============================================================ */
    .pie-pagina__enlace {
        display: inline-block;
        font-family: "Inter", sans-serif;
        font-size: 0.875rem;
        font-weight: 400;
        color: var(--pie-texto);
        text-decoration: none;
        transition:
            color var(--transicion),
            transform var(--transicion);
    }

    .pie-pagina__enlace:hover,
    .pie-pagina__enlace:focus-visible {
        color: var(--pie-texto-hover);
        transform: translateX(3px);
        outline: none;
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    /* Enlace destacado (CTA en lista) */
    .pie-pagina__enlace--destacado {
        color: var(--pie-acento);
        font-weight: 500;
    }

    .pie-pagina__enlace--destacado:hover,
    .pie-pagina__enlace--destacado:focus-visible {
        color: #c9a96e;
    }

    /* ============================================================
     FILA INFERIOR
     ============================================================ */
    .pie-pagina__inferior {
        display: flex;
        flex-direction: column;
        gap: 4px;
        align-items: flex-start;
        margin-top: clamp(32px, 5vw, 56px);
        padding-top: 24px;
        border-top: 1px solid var(--pie-borde);
    }

    @media (min-width: 768px) {
        .pie-pagina__inferior {
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
        }
    }

    .pie-pagina__copyright,
    .pie-pagina__credenciales {
        font-family: "Inter", sans-serif;
        font-size: 0.78rem;
        color: rgba(255, 255, 255, 0.38);
        margin: 0;
        line-height: 1.5;
    }

    /* ============================================================
     ACCESIBILIDAD — Utilidad sr-only
     ============================================================ */
    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    /* ============================================================
     FOCUS VISIBLE global para este componente
     ============================================================ */
    .pie-pagina *:focus-visible {
        outline: 2px solid var(--pie-acento);
        outline-offset: 3px;
        border-radius: var(--pie-radio);
    }
</style>
