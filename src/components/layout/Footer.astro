---
const anioActual = new Date().getFullYear();
import Logo from "./Logo.astro";
---

<footer class="pie-pagina" aria-labelledby="titulo-pie-pagina">
    <h2 id="titulo-pie-pagina" class="sr-only">Pie de página</h2>

    <div class="pie-pagina__contenedor">
        <div class="pie-pagina__grilla">
            <!-- Columna 1: Identidad -->
            <div class="pie-pagina__marca">
                <div class="pie-pagina__logo-wrap">
                    <Logo />
                </div>
                <p class="pie-pagina__descripcion">
                    Acompañamiento psicológico especializado, centrado en la
                    persona, con un abordaje humano e integrador.
                </p>
            </div>

            <!-- Columna 2: Navegación -->
            <nav class="pie-pagina__columna" aria-label="Navegación principal">
                <h3 class="pie-pagina__titulo-columna">Explorar</h3>
                <ul class="pie-pagina__lista">
                    <li>
                        <a href="#inicio" class="pie-pagina__enlace">Inicio</a>
                    </li>
                    <li>
                        <a href="#dispositivo" class="pie-pagina__enlace"
                            >Dispositivos</a
                        >
                    </li>
                    <li>
                        <a href="#beneficios" class="pie-pagina__enlace"
                            >Beneficios</a
                        >
                    </li>
                    <li>
                        <a href="#contacto" class="pie-pagina__enlace"
                            >Contacto</a
                        >
                    </li>
                </ul>
            </nav>

            <!-- Columna 3: Servicios -->
            <nav class="pie-pagina__columna" aria-label="Servicios">
                <h3 class="pie-pagina__titulo-columna">Servicios</h3>
                <ul class="pie-pagina__lista">
                    <li>
                        <a href="#comotrabajamos" class="pie-pagina__enlace"
                            >Metodología</a
                        >
                    </li>
                    <li>
                        <a href="#internacional" class="pie-pagina__enlace"
                            >Pacientes Internacionales</a
                        >
                    </li>
                    <li>
                        <a
                            href="#contacto"
                            class="pie-pagina__enlace pie-pagina__enlace--destacado"
                            >Solicitar Consulta</a
                        >
                    </li>
                </ul>
            </nav>

            <!-- Columna 4: Legal -->
            <nav class="pie-pagina__columna" aria-label="Legal">
                <h3 class="pie-pagina__titulo-columna">Legal</h3>
                <ul class="pie-pagina__lista">
                    <li>
                        <a href="/privacidad" class="pie-pagina__enlace"
                            >Privacidad</a
                        >
                    </li>
                    <li>
                        <a href="/terminos" class="pie-pagina__enlace"
                            >Términos</a
                        >
                    </li>
                </ul>
            </nav>
        </div>

        <!-- Badges de Confianza: Ahora dentro de la zona de cierre -->
        <div class="pie-pagina__certificaciones">
            <div class="badge-item">
                <span class="badge-icon">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M20 6 9 17l-5-5"></path></svg
                    >
                </span>
                <span class="badge-text">Atención Ética</span>
            </div>
            <div class="badge-item">
                <span class="badge-icon">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path
                            d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                        ></path><path d="M14 2v6h6"></path><path d="M9 15h6"
                        ></path><path d="M9 11h6"></path></svg
                    >
                </span>
                <span class="badge-text">Credenciales Verificadas</span>
            </div>
            <div class="badge-item">
                <span class="badge-icon">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><circle cx="12" cy="12" r="10"></circle><path
                            d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"
                        ></path><path d="M2 12h20"></path></svg
                    >
                </span>
                <span class="badge-text">Pacientes Internacionales</span>
            </div>
        </div>

        <div class="pie-pagina__inferior">
            <p class="pie-pagina__copyright">
                &copy; {anioActual}
                <strong>Vinculo Vital</strong>. Todos los derechos reservados.
            </p>
            <p class="pie-pagina__autor">Diseño de Alta Fidelidad</p>
        </div>
    </div>
</footer>

<style>
    .pie-pagina {
        --p-fondo: #050a12;
        --p-oro: #c5a47e;
        --p-oro-tenue: rgba(197, 164, 126, 0.15);
        --p-texto-muted: rgba(255, 255, 255, 0.5);
        --p-borde: rgba(255, 255, 255, 0.05);

        background-color: var(--p-fondo);
        padding: clamp(60px, 10vh, 100px) 0 40px;
        color: white;
        font-family:
            system-ui,
            -apple-system,
            sans-serif;
    }

    .pie-pagina__contenedor {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    .pie-pagina__grilla {
        display: grid;
        grid-template-columns: 1fr;
        gap: 3rem;
        padding-bottom: 4rem;
    }

    @media (min-width: 992px) {
        .pie-pagina__grilla {
            grid-template-columns: 2fr 1fr 1fr 1fr;
            gap: 2rem;
        }
    }

    .pie-pagina__marca {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .pie-pagina__logo-wrap {
        max-width: 180px;
        opacity: 0.9;
    }

    .pie-pagina__descripcion {
        color: var(--p-texto-muted);
        line-height: 1.7;
        font-size: 0.95rem;
        max-width: 32ch;
    }

    .pie-pagina__titulo-columna {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: var(--p-oro);
        margin-bottom: 1.5rem;
        font-weight: 700;
    }

    .pie-pagina__lista {
        list-style: none;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
    }

    .pie-pagina__enlace {
        color: var(--p-texto-muted);
        text-decoration: none;
        font-size: 0.9rem;
        transition: all 0.3s ease;
    }

    .pie-pagina__enlace:hover {
        color: white;
        transform: translateX(3px);
    }

    .pie-pagina__enlace--destacado {
        color: var(--p-oro);
        font-weight: 500;
    }

    /* Sección de Certificaciones / Badges */
    .pie-pagina__certificaciones {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
        padding: 2rem 0;
        border-top: 1px solid var(--p-borde);
        border-bottom: 1px solid var(--p-borde);
    }

    .badge-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .badge-icon {
        width: 28px;
        height: 28px;
        display: grid;
        place-items: center;
        background: var(--p-oro-tenue);
        color: var(--p-oro);
        border-radius: 50%;
    }

    .badge-text {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--p-texto-muted);
        font-weight: 500;
    }

    /* Copyright */
    .pie-pagina__inferior {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        padding-top: 2rem;
        gap: 1rem;
    }

    @media (min-width: 768px) {
        .pie-pagina__inferior {
            flex-direction: row;
        }
    }

    .pie-pagina__copyright,
    .pie-pagina__autor {
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.2);
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        border: 0;
    }
</style>
