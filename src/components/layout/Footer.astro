<style>
    .pie-pagina {
        /* Redefinimos localmente para evitar conflictos */
        --p-fondo: #03070d;
        --p-borde: rgba(180, 147, 90, 0.1);
        --p-oro: #b4935a;
        --p-texto: rgba(255, 255, 255, 0.5);

        background-color: var(--p-fondo);
        border-top: 1px solid var(--p-borde);
        padding-block: clamp(60px, 10vh, 100px);
        width: 100%;
        color: white;
    }

    .pie-pagina__contenedor {
        max-width: 1200px;
        margin-inline: auto;
        padding-inline: 2rem;
    }

    /* GRILLA: Forzamos el comportamiento para que no se amontone */
    .pie-pagina__grilla {
        display: grid;
        grid-template-columns: 1fr;
        gap: 3rem;
    }

    /* Desktop: 4 columnas con la primera más ancha */
    @media (min-width: 992px) {
        .pie-pagina__grilla {
            grid-template-columns: 1.5fr 0.8fr 0.8fr 0.8fr;
            gap: 2rem;
        }
    }

    /* Columna Marca */
    .pie-pagina__logo {
        font-family: "Lora", serif;
        font-size: 1.5rem;
        margin-bottom: 1rem;
        color: white;
    }

    .pie-pagina__logo em {
        color: var(--p-oro);
        font-style: italic;
    }

    .pie-pagina__descripcion {
        font-size: 0.9rem;
        line-height: 1.8;
        color: var(--p-texto);
        max-width: 30ch;
        font-weight: 300;
    }

    /* Títulos de columna: Estilo "Agencia" */
    .pie-pagina__titulo-columna {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: white;
        margin-bottom: 1.5rem;
        opacity: 0.9;
    }

    .pie-pagina__lista {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
    }

    .pie-pagina__enlace {
        color: var(--p-texto);
        text-decoration: none;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        display: inline-block;
    }

    .pie-pagina__enlace:hover {
        color: var(--p-oro);
        transform: translateX(5px);
    }

    /* Fila Inferior (Copyright) */
    .pie-pagina__inferior {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid var(--p-borde);
        display: flex;
        flex-direction: column;
        gap: 1rem;
        justify-content: space-between;
        align-items: center;
    }

    @media (min-width: 768px) {
        .pie-pagina__inferior {
            flex-direction: row;
        }
    }

    .pie-pagina__copyright,
    .pie-pagina__credenciales {
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.3);
    }

    .pie-pagina__enlace--destacado {
        color: var(--p-oro);
        font-weight: 500;
        border: 1px solid var(--p-oro);
        border-radius: 2px;
        padding: 0.5rem 1rem;
    }

    /* Utilidad para ocultar (Accessibility) */
    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        border: 0;
    }
</style>
