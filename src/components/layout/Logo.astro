---
import { Image } from "astro:assets";
import logoImg from "../../assets/images/Logo.png";
---

<a href="#hero-section" class="logo-link" aria-label="Ir al inicio">
    <div class="logo-container">
        <Image
            format="avif"
            src={logoImg}
            alt="Logotipo de Vínculo Vital"
            class="logo-img"
            loading="eager"
        />
    </div>

    <span class="logo-text">Vínculo <em>Vital</em></span>
</a>

<style>
    .logo-link {
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 12px; /* Espacio exacto entre imagen y texto */
        transition: opacity 0.3s ease;
    }

    .logo-container {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 60px; /* Contenedor fijo para evitar saltos de layout */
    }

    .logo-img {
        height: 100%; /* Ocupa el alto del contenedor */
        width: auto;
        object-fit: contain;
        transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .logo-text {
        font-family: "Lora", serif;
        font-size: 1.35rem; /* Un poco más de presencia */
        font-weight: 500;
        color: #ffffff;
        white-space: nowrap;
        letter-spacing: -0.02em; /* Estilo editorial más marcado */
        line-height: 1;
    }

    .logo-text em {
        color: var(--accent);
        font-style: italic;
        /* Un ligero ajuste de peso para el italic si es necesario */
        font-weight: 400;
    }

    /* Interacción Premium */
    .logo-link:hover .logo-img {
        transform: scale(1.08) rotate(-2deg); /* Un giro mínimo le da un toque orgánico */
    }

    .logo-link:hover .logo-text {
        opacity: 0.9;
    }

    /* Ajuste para mobile: reducimos un poco el tamaño global */
    @media (max-width: 768px) {
        .logo-container {
            height: 48px;
        }
        .logo-text {
            font-size: 1.1rem;
        }
    }
</style>
