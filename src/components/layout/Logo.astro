---
import { Image } from "astro:assets";
import logoImg from "../../assets/images/logo.svg";
---

<a href="#inicio" class="logo-link">
    <!-- El logo en imagen -->
    <Image src={logoImg} alt="Vínculo Vital" class="logo-img" />

    <span class="logo-text">Vinculo <em>Vital</em></span>
</a>

<style>
    .logo-link {
        text-decoration: none;
        padding: 0.5rem 0;
        display: inline-flex;
        align-items: center;
    }
    .logo-text {
        font-family: "Lora", serif;
        font-size: 1.25rem; /* Un pelín más grande para que destaque en el header */
        font-weight: 500; /* Un poco más de cuerpo ayuda a la legibilidad */
        color: white;
        white-space: nowrap;
        letter-spacing: -0.01em; /* Un toque editorial: junta apenas las letras */
    }
    .logo-text em {
        color: var(--accent);
        font-style: italic;
    }

    .logo-img {
        height: 40px; /* Ajusta según el diseño */
        width: auto; /* Mantiene la proporción */
        object-fit: contain;
        transition: transform 0.3s ease;
    }

    .logo-link:hover .logo-img {
        transform: scale(1.05); /* Un efecto sutil al pasar el mouse */
    }
</style>
