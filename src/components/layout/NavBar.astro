---
import Logo from "./Logo.astro";
---

<nav id="main-nav" class="nav" aria-label="Navegación principal">
  <div class="nav-inner">
    <!-- Logo -->
    <a
      href="#inicio"
      class="nav-logo-link"
      aria-label="Atelier Medical – inicio"
    >
      <Logo />
    </a>

    <!-- Desktop links -->
    <ul class="nav-links" role="list">
      <li><a href="#" class="nav-link">Inicio</a></li>
      <li><a href="#dispositivo" class="nav-link">Dispositivo</a></li>
      <!-- Antes Servicios -->
      <li><a href="#equipo" class="nav-link">Equipo</a></li>
      <!-- Antes Nosotros -->
      <li><a href="#internacional" class="nav-link">Área Internacional</a></li>
      <!-- Nuevo link clave -->
    </ul>

    <!-- CTA con el nuevo lenguaje -->
    <a href="#contacto" class="nav-cta-desktop">Solicitar Evaluación</a>

    <!-- Hamburger button -->
    <button
      id="nav-toggle"
      class="nav-toggle"
      aria-controls="mobile-drawer"
      aria-expanded="false"
      aria-label="Abrir menú"
    >
      <span class="bar bar-1"></span>
      <span class="bar bar-2"></span>
      <span class="bar bar-3"></span>
    </button>
  </div>
</nav>

<div
  id="mobile-drawer"
  class="drawer"
  role="dialog"
  aria-modal="true"
  aria-label="Menú de navegación"
>
  <!-- X close button -->
  <button id="drawer-close" class="drawer-close" aria-label="Cerrar menú">
    <svg
      width="22"
      height="22"
      viewBox="0 0 22 22"
      fill="none"
      aria-hidden="true"
    >
      <line
        x1="2"
        y1="2"
        x2="20"
        y2="20"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"></line>
      <line
        x1="20"
        y1="2"
        x2="2"
        y2="20"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"></line>
    </svg>
  </button>

  <div class="drawer-logo-container">
    <Logo />
  </div>

  <!-- Mobile links actualizados -->
  <ul class="drawer-links" role="list">
    <li><a href="#inicio" class="drawer-link">Inicio</a></li>
    <li><a href="#dispositivo" class="drawer-link">Dispositivo</a></li>
    <li><a href="#equipo" class="drawer-link">Equipo</a></li>
    <li><a href="#internacional" class="drawer-link">Área Internacional</a></li>
    <li><a href="#contacto" class="drawer-link">Contacto</a></li>
  </ul>
  <a href="#contacto" class="drawer-cta-mobile">Solicitar Evaluación</a>
</div>
<!-- Backdrop -->
<div id="drawer-backdrop" class="backdrop" aria-hidden="true"></div>

<style>
  :root {
    /* El resto déjalo igual, son variables únicas de este componente */
    --glass-bg: rgba(8, 18, 38, 0);
    --glass-border: rgba(255, 255, 255, 0.1);
    --link-idle: rgba(255, 255, 255, 0.82);
    --link-hover: #ffffff;
    --link-active: #ffffff;
    --ease: cubic-bezier(0.4, 0, 0.2, 1);
    --drawer-w: min(375px, 90vw);
    --nav-h: 70px;
  }

  .nav {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 900;
    height: var(--nav-h);
    background: var(--glass-bg);
    backdrop-filter: blur(50px);
    -webkit-backdrop-filter: blur(50px);
    border-bottom: 0.5px solid var(--glass-border);
    transition:
      background 0.35s var(--ease),
      height 0.35s var(--ease);
  }

  .nav-inner {
    max-width: 1400px;
    height: 100%;
    margin-inline: auto;
    padding-inline: clamp(32px, 5vw, 40px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
  }

  .nav-logo-link {
    text-decoration: none;
    transition: opacity 0.2s;
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .nav-logo-link:hover {
    opacity: 0.85;
  }

  .drawer-logo-container {
    margin-bottom: 20px;
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .nav-links {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  .nav-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    padding: 4px 5px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    cursor: pointer;
  }

  .nav-link {
    position: relative;
    padding: 6px 12px;
    color: var(--link-idle);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    letter-spacing: 0.025em;
    border-radius: 6px;
    transition:
      color 0.22s,
      background 0.22s;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    inset-inline: 12px;
    bottom: 2px;
    height: 2px;
    background: var(--accent);
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }

  .nav-link:hover {
    color: var(--link-hover);
    background: rgba(255, 255, 255, 0.07);
  }

  .nav-link.active {
    color: var(--link-active);
  }

  .nav-link.active::after {
    transform: scaleX(1);
  }

  .nav-cta-desktop {
    margin-left: 12px;
    padding: 10px 20px;
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    display: none;

    transition: transform 0.2s;
    border: 0.5px solid #b4935a;
  }

  .nav-cta-desktop:hover {
    transform: translateY(-4px);
  }

  .bar {
    display: block;
    height: 2px;
    background: #ffffff;
    border-radius: 2px;
    transition:
      transform 0.3s var(--ease),
      opacity 0.2s;
  }
  .bar-1,
  .bar-3 {
    width: 20px;
  }
  .bar-2 {
    width: 14px;
    align-self: flex-end;
  }

  .nav-toggle.open .bar-1 {
    transform: translateY(7px) rotate(45deg);
    width: 20px;
  }
  .nav-toggle.open .bar-2 {
    opacity: 0;
    transform: scaleX(0);
  }
  .nav-toggle.open .bar-3 {
    transform: translateY(-7px) rotate(-45deg);
    width: 20px;
    align-self: flex-start;
  }

  .backdrop {
    position: fixed;
    inset: 0;
    z-index: 910;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(2px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s var(--ease);
  }
  .backdrop.visible {
    opacity: 1;
    pointer-events: all;
  }

  .drawer {
    position: fixed;
    inset-block: 0;
    inset-inline-end: 0;
    z-index: 920;
    width: var(--drawer-w);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 90px 10px 28px; /* Más aire arriba para no chocar con la X */
    transform: translateX(100%);
    transition: transform 0.5s cubic-bezier(0.2, 1, 0.3, 1);
    box-shadow: -10px 0 50px rgba(0, 0, 0, 0.3);
  }

  .drawer.open {
    transform: translateX(0);
  }

  /* Botón cerrar: Más elegante y minimalista */
  .drawer-close {
    position: absolute;
    top: 30px;
    right: 30px;
    width: 44px;
    height: 44px;
    color: var(--accent);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .drawer-close:hover {
    background: rgba(180, 147, 90, 0.1);
    transform: rotate(90deg);
  }

  /* Contenedor de links */
  .drawer-links {
    list-style: none;
    margin: 0 0 10px;
    padding: 0;
    width: 100%;
  }

  /* Link individual: Estilo Editorial */
  .drawer-link {
    display: block;
    padding-block: 10px;
    font-family: "Lora", serif;
    font-size: 1.5rem; /* Un poco más grande para legibilidad móvil */
    text-decoration: none;
    text-align: center;
    border-bottom: 1px solid rgba(180, 147, 90, 0.12);
    transition: all 0.4s var(--ease);
    opacity: 0.8;
  }

  .drawer-link:hover,
  .drawer-link:active {
    opacity: 1;
    color: var(--accent);
    transform: scale(1.02);
    letter-spacing: 0.02em;
  }

  /* Botón de acción (CTA) en el móvil */
  .drawer-cta-mobile {
    display: inline-block;
    width: 80%;
    padding: 10px 20px;
    text-align: center;
    font-weight: 300;
    border-radius: 12px;
    text-decoration: none;
    transition: transform 0.2s ease;
    font-size: 1.1rem;
    border: 1px solid rgba(180, 147, 90, 0.7);
    background-color: #1b1e27;
    color: #ffffff;
  }

  .drawer-cta-mobile:hover {
    background-color: #1b1e27;
    color: var(--accent);
    transform: scale(1.02);
    border: 1px solid rgba(180, 147, 90, 1);
  }

  .drawer-cta-mobile:active {
    transform: scale(0.98);
  }

  @media (min-width: 768px) {
    .nav-inner {
      padding-inline: 60px;
      gap: 0;
    }
    .nav-toggle {
      display: none;
    }
    .nav-links {
      display: flex;
      margin-left: auto;
      gap: 24px;
      justify-content: center;
      flex: 1;
    }

    .nav-cta-desktop {
      display: inline-block;
    }
  }

  @media (min-width: 1280px) {
    .nav-links {
      gap: 12px;
      margin-inline: 160px;
    }
  }
</style>

<script>
  const nav = document.getElementById("main-nav") as HTMLElement | null;
  const toggle = document.getElementById(
    "nav-toggle",
  ) as HTMLButtonElement | null;
  const drawer = document.getElementById("mobile-drawer") as HTMLElement | null;
  const backdrop = document.getElementById(
    "drawer-backdrop",
  ) as HTMLElement | null;
  const closeBtn = document.getElementById(
    "drawer-close",
  ) as HTMLButtonElement | null;
  const navLinks = document.querySelectorAll<HTMLAnchorElement>(".nav-link");
  const drawerLinks = document.querySelectorAll<HTMLAnchorElement>(
    ".drawer-link, .drawer-cta",
  );

  let sections: Element[] = [];
  let ticking = false;

  /* ---- Init ---- */
  const init = (): void => {
    sections = Array.from(document.querySelectorAll("section[id]"));
  };

  /* ---- Open / close drawer ---- */
  const openDrawer = (): void => {
    drawer?.classList.add("open");
    backdrop?.classList.add("visible");
    toggle?.classList.add("open");
    toggle?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  };

  const closeDrawer = (): void => {
    drawer?.classList.remove("open");
    backdrop?.classList.remove("visible");
    toggle?.classList.remove("open");
    toggle?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  };

  toggle?.addEventListener("click", () => {
    const isOpen = drawer?.classList.contains("open");
    isOpen ? closeDrawer() : openDrawer();
  });

  closeBtn?.addEventListener("click", closeDrawer);
  backdrop?.addEventListener("click", closeDrawer);
  drawerLinks.forEach((l) => l.addEventListener("click", closeDrawer));

  /* Escape key */
  document.addEventListener("keydown", (e: KeyboardEvent) => {
    if (e.key === "Escape") closeDrawer();
  });

  /* ---- Scroll handler ---- */
  const onScroll = (): void => {
    const y = window.scrollY;
    const trigger = 100;

    nav?.classList.toggle("scrolled", y > 50);

    let current: string | null = null;
    for (const section of sections) {
      const rect: DOMRect = section.getBoundingClientRect();
      if (rect.top <= trigger && rect.bottom > trigger) {
        current = section.id;
        break;
      }
    }

    navLinks.forEach((link: HTMLAnchorElement) => {
      const href: string | null = link.getAttribute("href");
      link.classList.toggle(
        "active",
        Boolean(current && href === `#${current}`),
      );
    });
  };

  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          onScroll();
          ticking = false;
        });
        ticking = true;
      }
    },
    { passive: true },
  );

  /* ---- Boot ---- */
  const setup = (): void => {
    init();
    onScroll();
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setup, { once: true });
  } else {
    setup();
  }

  document.addEventListener("astro:page-load", setup);
</script>
